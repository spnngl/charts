{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Keeps OUR tooling current: pinned tool versions, GitHub Actions SHAs, kind node images. CRD sync is handled by .github/workflows/sync.yml, not Renovate.",
    "extends": ["github>spnngl/.github:renovate.default.json5"],
    "baseBranchPatterns": ["main"],
    "schedule": ["at any time"],
    "automergeSchedule": ["at any time"],
    "enabledManagers": ["github-actions", "custom.regex"],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Tool versions in tooling/versions.toml, annotated with `# renovate:` comments.",
            "managerFilePatterns": ["/^tooling/versions\\.toml$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s*\\n[a-z0-9-]+ = \"(?<currentValue>[^\"]+)\""
            ],
            "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}"
        },
        {
            "customType": "regex",
            "description": "kind node images in the PR workflow matrix.",
            "managerFilePatterns": ["/^\\.github/workflows/pr\\.yml$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>docker) depName=(?<depName>kindest/node)\\s*\\n\\s*- \\{ name: \"[^\"]+\", image: \"kindest/node:(?<currentValue>v[^@\"]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\" \\}"
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
        },
        {
            "customType": "regex",
            "description": "Upstream image of hand-written charts: `appVersion` and the tag + digest in the artifacthub.io/images annotation (one file, one PR).",
            "managerFilePatterns": ["/^charts/[^/]+/Chart\\.yaml$/"],
            "matchStrings": [
                "# renovate: datasource=docker depName=(?<depName>[^\\s]+)\\s*\\nappVersion: \"(?<currentValue>[^\"]+)\"",
                "image: (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
        }
    ],
    "packageRules": [
        {
            "description": "Tool and image updates: automerge minor/patch once CI is green. GitHub Actions: see the shared preset.",
            "matchManagers": ["custom.regex"],
            "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
            "automerge": true
        },
        {
            "description": "kind node images: only patch bumps within the same minor automatically (the matrix minors are chosen by hand).",
            "matchDepNames": ["kindest/node"],
            "matchUpdateTypes": ["minor", "major"],
            "enabled": false
        },
        {
            "description": "Helm is pinned twice in tooling/versions.toml: keep `helm` on 3.x (generator, release, Helm 3 install tests).",
            "matchDepNames": ["helm/helm"],
            "matchCurrentValue": "/^3\\./",
            "allowedVersions": "<4.0.0",
            "automerge": true
        },
        {
            "description": "Keep `helm4` on 4.x (Helm 4 install tests).",
            "matchDepNames": ["helm/helm"],
            "matchCurrentValue": "/^4\\./",
            "allowedVersions": "<5.0.0",
            "automerge": true
        },
        {
            "description": "Chart images: 2-day release age (skipped where the registry has no timestamp: ghcr.io, quay.io), chart `version` patch bump for ct.",
            "matchManagers": ["custom.regex"],
            "matchFileNames": ["charts/*/Chart.yaml"],
            "minimumReleaseAge": "2 days",
            "minimumReleaseAgeBehaviour": "timestamp-optional",
            "bumpVersions": [
                {
                    "filePatterns": ["{{packageFileDir}}/Chart.yaml"],
                    "bumpType": "patch",
                    "matchStrings": ["\\nversion:\\s*(?<version>[^\\s]+)"]
                }
            ]
        },
        {
            "description": "cloudflared: calver (major = year), automerge majors too.",
            "matchDepNames": ["docker.io/cloudflare/cloudflared"],
            "matchUpdateTypes": ["major"],
            "automerge": true
        },
        {
            "description": "ghcr-exporter: tags carry a `v` prefix, which the chart manager's `^X.Y.Z$` versioning rejects. Weekly (the `schedule:weekly` cron: presets cannot be extended in packageRules): upstream ships several dependency-bump patches a month and each automerge publishes a chart patch, so the open PR rolls forward to the latest tag and at most one chart release is cut per week.",
            "matchDepNames": ["ghcr.io/d0ugal/ghcr-exporter"],
            "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
            "schedule": ["* 0-3 * * 1"]
        },
        {
            "description": "github-exporter: tags carry a `v` prefix, which the chart manager's `^X.Y.Z$` versioning rejects. Weekly (the `schedule:weekly` cron: presets cannot be extended in packageRules): upstream ships several dependency-bump patches a month and each automerge publishes a chart patch, so the open PR rolls forward to the latest tag and at most one chart release is cut per week.",
            "matchDepNames": ["ghcr.io/d0ugal/github-exporter"],
            "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
            "schedule": ["* 0-3 * * 1"]
        }
    ]
}
