{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "description": "Affinity.",
      "required": [],
      "type": "object"
    },
    "cinny": {
      "additionalProperties": false,
      "description": "Cinny, a Matrix web client: a stateless Deployment of its own, so a client patch\nnever restarts the homeserver.",
      "properties": {
        "affinity": {
          "additionalProperties": true,
          "description": "Affinity, merged over the chart default: a preferred pod anti-affinity that spreads the replicas over nodes (set `podAntiAffinity` to replace it).",
          "required": [],
          "type": "object"
        },
        "config": {
          "additionalProperties": true,
          "description": "Cinny `config.json` (homeservers, featured communities, hash router, see `config.json` upstream), merged over the chart defaults: `homeserverList: [\u003cserverName\u003e]`, `defaultHomeserver: 0`, `allowCustomHomeservers: false`. Cinny resolves each entry of `homeserverList` through its `/.well-known/matrix/client`: use `ingress.wellKnown` or `httpRoute.wellKnown` when `serverName` is not the homeserver host. The browser reads the file, so keep secrets out.",
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Deploy Cinny.",
          "type": "boolean"
        },
        "httpRoute": {
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "HTTPRoute annotations.",
              "required": [],
              "type": "object"
            },
            "enabled": {
              "description": "Create a Gateway API HTTPRoute for Cinny (path prefix `/`).",
              "type": "boolean"
            },
            "hostnames": {
              "description": "Host names (empty: any host of the Gateway listener).",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "labels": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Extra HTTPRoute labels.",
              "required": [],
              "type": "object"
            },
            "parentRefs": {
              "description": "Gateways (`parentRefs`). Required when enabled.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "image": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "description": "Image digest, only valid together with `cinny.image.tag`.",
              "pattern": "^(sha256:[a-f0-9]{64})?$",
              "type": "string"
            },
            "pullPolicy": {
              "description": "Image pull policy.",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ],
              "type": "string"
            },
            "repository": {
              "description": "Image repository.",
              "type": "string"
            },
            "tag": {
              "description": "Image tag. Empty: the tag and digest recorded for `cinny.image.repository` in the `artifacthub.io/images` annotation of `Chart.yaml`. When set, the chart digest is not applied; add `cinny.image.digest` to pin it.",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "ingress": {
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Ingress annotations.",
              "required": [],
              "type": "object"
            },
            "className": {
              "description": "Ingress class name (empty: cluster default).",
              "type": "string"
            },
            "enabled": {
              "description": "Create an Ingress for Cinny (path `/`).",
              "type": "boolean"
            },
            "hosts": {
              "description": "Host names. Required when enabled. Not the homeserver host unless you route paths yourself: both Ingresses serve `/`.",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "labels": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Extra Ingress labels.",
              "required": [],
              "type": "object"
            },
            "tls": {
              "description": "Ingress TLS blocks (`secretName`, `hosts`).",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "livenessProbe": {
          "additionalProperties": true,
          "description": "Liveness probe (`GET /health`).",
          "properties": {
            "failureThreshold": {
              "type": "integer"
            },
            "periodSeconds": {
              "type": "integer"
            },
            "timeoutSeconds": {
              "type": "integer"
            }
          },
          "required": [],
          "type": "object"
        },
        "minReadySeconds": {
          "description": "Seconds a new pod must be ready before it counts as available (rolling updates never drop below `replicaCount`).",
          "minimum": 0,
          "type": "integer"
        },
        "podDisruptionBudget": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "description": "Create a PodDisruptionBudget (`unhealthyPodEvictionPolicy: AlwaysAllow`).",
              "type": "boolean"
            },
            "maxUnavailable": {
              "description": "Pods that may be unavailable at once (a number or a percentage).",
              "required": [],
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "required": [],
          "type": "object"
        },
        "priorityClassName": {
          "description": "Priority class name.",
          "type": "string"
        },
        "readinessProbe": {
          "additionalProperties": true,
          "description": "Readiness probe (`GET /health`).",
          "properties": {
            "failureThreshold": {
              "type": "integer"
            },
            "periodSeconds": {
              "type": "integer"
            },
            "timeoutSeconds": {
              "type": "integer"
            }
          },
          "required": [],
          "type": "object"
        },
        "replicaCount": {
          "description": "Replicas. Cinny is stateless: two give a rolling update with no gap.",
          "minimum": 1,
          "type": "integer"
        },
        "resources": {
          "additionalProperties": true,
          "description": "Resources of the cinny container. A scheduling floor, not a sizing (VPA in `Off` mode gives recommendations). No CPU limit on purpose.",
          "properties": {
            "limits": {
              "additionalProperties": true,
              "properties": {
                "memory": {
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "requests": {
              "additionalProperties": true,
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "service": {
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Service annotations.",
              "required": [],
              "type": "object"
            },
            "port": {
              "description": "Service port (the container listens on 8080).",
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            "type": {
              "description": "Service type.",
              "enum": [
                "ClusterIP",
                "LoadBalancer",
                "NodePort"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "startupProbe": {
          "additionalProperties": true,
          "description": "Startup probe (`GET /health`).",
          "properties": {
            "failureThreshold": {
              "type": "integer"
            },
            "periodSeconds": {
              "type": "integer"
            },
            "timeoutSeconds": {
              "type": "integer"
            }
          },
          "required": [],
          "type": "object"
        },
        "terminationGracePeriodSeconds": {
          "description": "Seconds Cinny gets to stop (the server drains on SIGTERM).",
          "minimum": 0,
          "type": "integer"
        },
        "tolerations": {
          "description": "Tolerations.",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        },
        "topologySpreadConstraints": {
          "description": "Topology spread constraints. Empty: the chart spreads the replicas over zones (`topology.kubernetes.io/zone`, `ScheduleAnyway`). A list you set replaces it and needs its own `labelSelector`.",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        },
        "verticalPodAutoscaler": {
          "additionalProperties": false,
          "properties": {
            "controlledResources": {
              "description": "Resources VPA controls.",
              "items": {
                "enum": [
                  "cpu",
                  "memory"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "controlledValues": {
              "description": "Whether VPA also scales limits.",
              "enum": [
                "RequestsAndLimits",
                "RequestsOnly"
              ],
              "type": "string"
            },
            "enabled": {
              "description": "Create a VerticalPodAutoscaler for Cinny (needs the VPA CRDs, see the `vertical-pod-autoscaler-crds` chart).",
              "type": "boolean"
            },
            "maxAllowed": {
              "additionalProperties": true,
              "description": "Upper bound of recommendations.",
              "required": [],
              "type": "object"
            },
            "minAllowed": {
              "additionalProperties": true,
              "description": "Lower bound of recommendations.",
              "required": [],
              "type": "object"
            },
            "recommender": {
              "description": "Recommender name (`spec.recommenders`, which takes at most one). Empty: the recommender named `default`.",
              "type": "string"
            },
            "updateMode": {
              "description": "VPA update mode.",
              "enum": [
                "Off",
                "Initial",
                "Recreate",
                "InPlaceOrRecreate"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "config": {
      "additionalProperties": true,
      "description": "tuwunel settings (the `[global]` table of `tuwunel.toml`, see `tuwunel-example.toml` upstream), rendered into a ConfigMap. Nested maps become `[global.\u003ckey\u003e]` tables. Chart-owned keys (`server_name`, `database_path`, `address`, `port`, `unix_socket_path`) are rejected. With `ingress.wellKnown` or `httpRoute.wellKnown` the chart defaults `well_known.client` and `well_known.server`; your values win. Secrets go through `existingSecret` and the `*_file` options, never here.",
      "propertyNames": {
        "not": {
          "enum": [
            "server_name",
            "database_path",
            "address",
            "port",
            "unix_socket_path"
          ],
          "required": []
        },
        "pattern": "^[a-z0-9_]+$",
        "required": []
      },
      "required": [],
      "type": "object"
    },
    "dnsConfig": {
      "additionalProperties": true,
      "description": "DNS config.",
      "properties": {
        "options": {
          "description": "DNS options (fewer search-list lookups for federation host names).",
          "items": {
            "additionalProperties": true,
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "existingSecret": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Name of a Secret to mount at `/etc/tuwunel/secrets` (mode 0440), for the `*_file` options: `registration_token_file`, `registration_shared_secret_file`, `turn_secret_file`, `ldap.bind_password_file`, `identity_provider[].client_secret_file`. Each key becomes a file. Empty: nothing mounted. The chart never creates it.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "extraArgs": {
      "description": "Extra `tuwunel` options, after the chart's own (none). Options for the config file and options that exit or start another mode are rejected.",
      "items": {
        "minLength": 1,
        "not": {
          "pattern": "^(?:-[cO]|--(?:config|option|health-check|generate-config|regenerate-config|restore-backup|test|bench)(?:=.*)?$)",
          "required": []
        },
        "type": "string"
      },
      "type": "array"
    },
    "extraEnv": {
      "description": "Extra environment variables (`EnvVar` list) for the tuwunel container. `TUWUNEL_\u003cKEY\u003e` variables win over the config file. Variables for chart-owned settings and the config file path are rejected.",
      "items": {
        "properties": {
          "name": {
            "minLength": 1,
            "not": {
              "pattern": "^(?:CONDUIT|CONDUWUIT|TUWUNEL)_(?:CONFIG|SERVER_NAME|DATABASE_PATH|ADDRESS|PORT|UNIX_SOCKET_PATH)$",
              "required": []
            },
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumeMounts": {
      "description": "Extra volume mounts for the tuwunel container.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumes": {
      "description": "Extra volumes.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "fullnameOverride": {
      "description": "Override the full resource name (default `\u003crelease\u003e-\u003cchart\u003e`).",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "type": "object"
    },
    "hostUsers": {
      "description": "Run the pods in a user namespace (`false`: uid 65532 maps to an unprivileged host uid). Needs node support (containerd 2.0+ or CRI-O, runc 1.2+, kernel 6.3+) and idmapped mounts on every volume's file system (not NFS/SMB, not `hostPath` on some file systems); pods fail to start otherwise. `true` uses host users.",
      "type": "boolean"
    },
    "httpRoute": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "HTTPRoute annotations.",
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a Gateway API HTTPRoute for the homeserver (path prefix `/`).",
          "type": "boolean"
        },
        "hostnames": {
          "description": "Host names (empty: any host of the Gateway listener). The first one is the homeserver host.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra HTTPRoute labels.",
          "required": [],
          "type": "object"
        },
        "parentRefs": {
          "description": "Gateways (`parentRefs`). Required when enabled.",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        },
        "wellKnown": {
          "description": "Delegate `serverName` to the homeserver host: create a second HTTPRoute (`\u003cfullname\u003e-well-known`) on host name `serverName`, path prefix `/.well-known/matrix`, and default `well_known.client` to `https://\u003cfirst host name\u003e` and `well_known.server` to `\u003cfirst host name\u003e:443`. Needs `hostnames`, and a Gateway listener accepting `serverName`.",
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "Image digest, only valid together with `image.tag`.",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "type": "string"
        },
        "pullPolicy": {
          "description": "Image pull policy.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "repository": {
          "description": "Image repository.",
          "type": "string"
        },
        "tag": {
          "description": "Image tag. Empty: the tag and digest recorded for `image.repository` in the `artifacthub.io/images` annotation of `Chart.yaml`. When set, the chart digest is not applied; add `image.digest` to pin it.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets (list of `{name: \u003csecret\u003e}`).",
      "items": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ingress": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ingress annotations.",
          "required": [],
          "type": "object"
        },
        "className": {
          "description": "Ingress class name (empty: cluster default).",
          "type": "string"
        },
        "enabled": {
          "description": "Create an Ingress for the homeserver (path `/`).",
          "type": "boolean"
        },
        "hosts": {
          "description": "Host names. Required when enabled. The first one is the homeserver host.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra Ingress labels (for example the label an external-dns `--label-filter` selects).",
          "required": [],
          "type": "object"
        },
        "tls": {
          "description": "Ingress TLS blocks (`secretName`, `hosts`).",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        },
        "wellKnown": {
          "description": "Delegate `serverName` to the homeserver host: add a rule on host `serverName`, path `/.well-known/matrix`, and default `well_known.client` to `https://\u003cfirst host\u003e` and `well_known.server` to `\u003cfirst host\u003e:443`. For a `serverName` that differs from the homeserver host (`example.com` served by `matrix.example.com`). Needs `hosts`. Add `serverName` to `tls`.",
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "livenessProbe": {
      "additionalProperties": true,
      "description": "Liveness probe (`tuwunel --health-check`).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "nameOverride": {
      "description": "yaml-language-server: $schema=values.schema.json\nOverride the chart name used in resource names and labels.",
      "type": "string"
    },
    "networkPolicy": {
      "additionalProperties": false,
      "properties": {
        "cinny": {
          "additionalProperties": false,
          "properties": {
            "from": {
              "description": "NetworkPolicyPeer list allowed to reach the Cinny port. Empty: any source (browsers reach it through your ingress controller or gateway).",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "egress": {
          "additionalProperties": false,
          "properties": {
            "dns": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "description": "DNS peers (port 53 TCP/UDP). Override for NodeLocal DNSCache or non-standard labels.",
                  "items": {
                    "required": [],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            },
            "enabled": {
              "description": "Restrict egress (DNS, internet peers for federation, push and URL previews, `extraEgress`).",
              "type": "boolean"
            },
            "extraEgress": {
              "description": "Extra `NetworkPolicyEgressRule`s.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            },
            "peers": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "description": "Internet peers (any port). Default: the internet, not the private, CGNAT and link-local ranges, so a compromised pod cannot move sideways. Remove an `except` entry to reach a server there.",
                  "items": {
                    "required": [],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a NetworkPolicy per component (ingress: the homeserver port).",
          "type": "boolean"
        },
        "homeserver": {
          "additionalProperties": false,
          "properties": {
            "from": {
              "description": "NetworkPolicyPeer list allowed to reach the homeserver port. Empty: any source (clients, federation and the ingress controller can be anywhere).",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "nodeSelector": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector. With a `hostPath`, pin the pod to the node.",
      "properties": {
        "kubernetes.io/os": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "persistence": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": false,
          "properties": {
            "emptyDir": {
              "additionalProperties": false,
              "properties": {
                "sizeLimit": {
                  "description": "Size limit (`type: emptyDir`, everything is lost with the pod). Empty: none.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "existingClaim": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "description": "Name of an existing PVC (`type: existingClaim`).",
                  "type": "string"
                },
                "subPath": {
                  "description": "Sub-path inside the claim.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "hostPath": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Absolute node path (`type: hostPath`), owned by uid/gid 65532. Pin the pod to the node.",
                  "type": "string"
                },
                "type": {
                  "description": "`hostPath` type. `DirectoryOrCreate` makes a root-owned directory the server cannot write.",
                  "enum": [
                    "Directory",
                    "DirectoryOrCreate"
                  ],
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "type": {
              "description": "Where `/var/lib/tuwunel` (database and uploaded media) lives. `volumeClaimTemplate` creates a PVC and keeps it on uninstall; the other types use the matching sub-section.",
              "enum": [
                "volumeClaimTemplate",
                "existingClaim",
                "hostPath",
                "emptyDir"
              ],
              "type": "string"
            },
            "volumeClaimTemplate": {
              "additionalProperties": false,
              "properties": {
                "accessModes": {
                  "description": "Access modes.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "annotations": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "PVC annotations.",
                  "required": [],
                  "type": "object"
                },
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "PVC labels.",
                  "required": [],
                  "type": "object"
                },
                "size": {
                  "description": "Requested size. The database and every uploaded file live here: size it for media. The template is immutable once installed: resize the PVC, see the README.",
                  "type": "string"
                },
                "storageClassName": {
                  "description": "StorageClass (empty: cluster default).",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
