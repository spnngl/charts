{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "externalDatabase": {
            "properties": {
              "enabled": {
                "const": true,
                "required": []
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "externalDatabase"
        ]
      },
      "required": [],
      "then": {
        "properties": {
          "externalDatabase": {
            "properties": {
              "existingSecret": {
                "properties": {
                  "name": {
                    "minLength": 1,
                    "required": []
                  }
                },
                "required": []
              },
              "host": {
                "minLength": 1,
                "required": []
              }
            },
            "required": []
          }
        },
        "required": []
      }
    }
  ],
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "description": "Affinity.",
      "required": [],
      "type": "object"
    },
    "apiKey": {
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "additionalProperties": false,
          "properties": {
            "key": {
              "description": "Key of the API key in the Secret.",
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "description": "Name of a Secret holding the API key, passed as `API_KEY`. Empty: no env, Seerr generates its own key and keeps it in `settings.json`. The chart never creates the Secret.",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "dnsConfig": {
      "additionalProperties": true,
      "description": "DNS config.",
      "properties": {
        "options": {
          "description": "DNS options (fewer search-list lookups for external host names such as TMDB).",
          "items": {
            "additionalProperties": true,
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "externalDatabase": {
      "additionalProperties": false,
      "properties": {
        "database": {
          "description": "Database name (`DB_NAME`).",
          "minLength": 1,
          "type": "string"
        },
        "enabled": {
          "description": "Use an external PostgreSQL instead of SQLite in `/app/config`. Seerr creates its tables but no database: create it first. Enabling it on an existing install starts empty; the SQLite data is not migrated.",
          "type": "boolean"
        },
        "existingSecret": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "description": "Name of the Secret holding the database login (for example a CloudNativePG role Secret). Required when enabled. The chart never creates it.",
              "type": "string"
            },
            "passwordKey": {
              "description": "Key of the password in the Secret.",
              "minLength": 1,
              "type": "string"
            },
            "usernameKey": {
              "description": "Key of the user name in the Secret.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "host": {
          "description": "PostgreSQL host. Required when enabled.",
          "type": "string"
        },
        "port": {
          "description": "PostgreSQL port.",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "extraEnv": {
      "description": "Extra environment variables (`EnvVar` list) for the Seerr container: `LOG_LEVEL` (the chart sets `info`; this overrides it), `TZ`, `DB_USE_SSL` and `DB_SSL_*` (PostgreSQL TLS), `DB_POOL_SIZE`. Names the chart sets are rejected: `API_KEY`, `PORT`, `HOST`, `CONFIG_DIRECTORY`, `DB_TYPE`, `DB_HOST`, `DB_PORT`, `DB_NAME`, `DB_USER`, `DB_PASS`, `DB_SOCKET_PATH`. Names are case-sensitive.",
      "items": {
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extraInitContainers": {
      "description": "Extra init containers, rendered as given: seed a file before start, or run a native sidecar (`restartPolicy: Always`) that calls the API. The Seerr image has no shell: use another image.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumeMounts": {
      "description": "Extra volume mounts for the Seerr container.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumes": {
      "description": "Extra volumes.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "fullnameOverride": {
      "description": "Override the full resource name (default `\u003crelease\u003e-\u003cchart\u003e`).",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "type": "object"
    },
    "hostUsers": {
      "description": "Run the pod in a user namespace (`false`: uid 65532 maps to an unprivileged host uid). Needs node support (containerd 2.0+ or CRI-O, runc 1.2+, kernel 6.3+) and idmapped mounts on every volume's file system (not NFS/SMB, not `hostPath` on some file systems); pods fail to start otherwise. `true` uses host users.",
      "type": "boolean"
    },
    "httpRoute": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "HTTPRoute annotations.",
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a Gateway API HTTPRoute for the web UI (path prefix `/`).",
          "type": "boolean"
        },
        "hostnames": {
          "description": "Host names (empty: any host of the Gateway listener).",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra HTTPRoute labels.",
          "required": [],
          "type": "object"
        },
        "parentRefs": {
          "description": "Gateways (`parentRefs`). Required when enabled.",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "Image digest, only valid together with `image.tag`.",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "type": "string"
        },
        "pullPolicy": {
          "description": "Image pull policy.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "repository": {
          "description": "Image repository.",
          "type": "string"
        },
        "tag": {
          "description": "Image tag. Empty: the tag and digest recorded for `image.repository` in the `artifacthub.io/images` annotation of `Chart.yaml`. When set, the chart digest is not applied; add `image.digest` to pin it.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets (list of `{name: \u003csecret\u003e}`).",
      "items": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ingress": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ingress annotations.",
          "required": [],
          "type": "object"
        },
        "className": {
          "description": "Ingress class name (empty: cluster default).",
          "type": "string"
        },
        "enabled": {
          "description": "Create an Ingress for the web UI (path `/`).",
          "type": "boolean"
        },
        "hosts": {
          "description": "Host names. Required when enabled.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra Ingress labels (for example the label an external-dns `--label-filter` selects).",
          "required": [],
          "type": "object"
        },
        "tls": {
          "description": "Ingress TLS blocks (`secretName`, `hosts`).",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "livenessProbe": {
      "additionalProperties": true,
      "description": "Liveness probe (`GET /api/v1/status/appdata`: a database outage must not restart the pod).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "nameOverride": {
      "description": "yaml-language-server: $schema=values.schema.json\nOverride the chart name used in resource names and labels.",
      "type": "string"
    },
    "networkPolicy": {
      "additionalProperties": false,
      "properties": {
        "egress": {
          "additionalProperties": false,
          "properties": {
            "dns": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "description": "DNS peers (port 53 TCP/UDP). Override for NodeLocal DNSCache or non-standard labels.",
                  "items": {
                    "required": [],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            },
            "enabled": {
              "description": "Restrict egress (DNS, the internet for TMDB and notifications, `extraEgress`).",
              "type": "boolean"
            },
            "extraEgress": {
              "description": "Extra `NetworkPolicyEgressRule`s: the database, Radarr, Sonarr and the media server (they are in the private ranges `peers` excludes).",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            },
            "peers": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "description": "TMDB, notification services and other internet hosts (any port). Default: the internet, not the private, CGNAT and link-local ranges, so a compromised process cannot move sideways. Remove an `except` entry to reach a provider there.",
                  "items": {
                    "required": [],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a NetworkPolicy (ingress: the web port).",
          "type": "boolean"
        },
        "http": {
          "additionalProperties": false,
          "properties": {
            "from": {
              "description": "NetworkPolicyPeer list allowed to reach the web UI and API port. Empty: any source. It must admit the Ingress controller and every client of the API.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "nodeSelector": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector. With a `hostPath`, pin the pod to the node.",
      "properties": {
        "kubernetes.io/os": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "persistence": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "additionalProperties": false,
          "properties": {
            "sizeLimit": {
              "description": "Size limit of the `emptyDir` on `/app/.next/cache` (Next.js' optimised images, rebuilt on demand). Empty: none. A limit that is hit evicts the pod.",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "config": {
          "additionalProperties": false,
          "properties": {
            "emptyDir": {
              "additionalProperties": false,
              "properties": {
                "sizeLimit": {
                  "description": "Size limit (`type: emptyDir`, state is lost with the pod). Empty: none.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "existingClaim": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "description": "Name of an existing PVC (`type: existingClaim`).",
                  "type": "string"
                },
                "subPath": {
                  "description": "Sub-path inside the claim.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "hostPath": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Absolute node path (`type: hostPath`), owned by uid/gid 65532. Pin the pod to the node.",
                  "type": "string"
                },
                "type": {
                  "description": "`hostPath` type. `DirectoryOrCreate` makes a root-owned directory the app cannot write.",
                  "enum": [
                    "Directory",
                    "DirectoryOrCreate"
                  ],
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "type": {
              "description": "Where `/app/config` (`settings.json`, the SQLite database unless `externalDatabase.enabled`, logs, the image proxy cache) lives. Block storage: SQLite on NFS corrupts. `volumeClaimTemplate` creates a PVC per pod and keeps it on uninstall; the other types use the matching sub-section.",
              "enum": [
                "volumeClaimTemplate",
                "existingClaim",
                "hostPath",
                "emptyDir"
              ],
              "type": "string"
            },
            "volumeClaimTemplate": {
              "additionalProperties": false,
              "properties": {
                "accessModes": {
                  "description": "Access modes.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "annotations": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "PVC annotations.",
                  "required": [],
                  "type": "object"
                },
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "PVC labels.",
                  "required": [],
                  "type": "object"
                },
                "size": {
                  "description": "Requested size. The template is immutable once installed: resize the PVC, see the README.",
                  "type": "string"
                },
                "storageClassName": {
                  "description": "StorageClass (empty: cluster default).",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Pod annotations.",
      "required": [],
      "type": "object"
    },
    "podLabels": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Extra pod labels.",
      "required": [],
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "description": "Pod security context. Overrides are merged onto these defaults. `fsGroup` does not apply to NFS/SMB volumes or `hostPath`.",
      "properties": {
        "fsGroup": {
          "type": "integer"
        },
        "fsGroupChangePolicy": {
          "type": "string"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "priorityClassName": {
      "description": "Priority class name.",
      "type": "string"
    },
    "readinessProbe": {
      "additionalProperties": true,
      "description": "Readiness probe (`GET /api/v1/status/appdata`, which does not read the database: the pod stays in the Service while PostgreSQL is down).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "resources": {
      "additionalProperties": true,
      "description": "Resources of the Seerr container. A scheduling floor, not a sizing: memory grows with the number of users and the size of the media scans (measure, then tune; VPA in `Off` mode gives recommendations). No CPU limit on purpose.",
      "properties": {
        "limits": {
          "additionalProperties": true,
          "properties": {
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "requests": {
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "revisionHistoryLimit": {
      "description": "Old ControllerRevisions to keep.",
      "type": "integer"
    },
    "securityContext": {
      "additionalProperties": true,
      "description": "Container security context of the Seerr container (read-only root filesystem: it writes only to the `/app/config`, `/app/.next/cache` and `/tmp` volumes). Overrides are merged onto these defaults.",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "additionalProperties": true,
          "properties": {
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "privileged": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "service": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Service annotations.",
          "required": [],
          "type": "object"
        },
        "port": {
          "description": "Web UI and API Service port (the container listens on 5055).",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "description": "Web UI and API Service type.",
          "enum": [
            "ClusterIP",
            "LoadBalancer",
            "NodePort"
          ],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "ServiceAccount annotations.",
          "required": [],
          "type": "object"
        },
        "create": {
          "description": "Create the ServiceAccount.",
          "type": "boolean"
        },
        "name": {
          "description": "ServiceAccount name. Empty: `\u003cfullname\u003e` (or `default` when `create` is false).",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "startupProbe": {
      "additionalProperties": true,
      "description": "Startup probe (`GET /api/v1/status/appdata`, which needs no login, no database and no outbound call; `/api/v1/status` calls GitHub and hangs with egress blocked).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "tolerations": {
      "description": "Tolerations.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "verticalPodAutoscaler": {
      "additionalProperties": false,
      "properties": {
        "controlledResources": {
          "description": "Resources VPA controls.",
          "items": {
            "enum": [
              "cpu",
              "memory"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "controlledValues": {
          "description": "Whether VPA also scales limits.",
          "enum": [
            "RequestsAndLimits",
            "RequestsOnly"
          ],
          "type": "string"
        },
        "enabled": {
          "description": "Create a VerticalPodAutoscaler (needs the VPA CRDs, see the `vertical-pod-autoscaler-crds` chart).",
          "type": "boolean"
        },
        "maxAllowed": {
          "additionalProperties": true,
          "description": "Upper bound of recommendations.",
          "required": [],
          "type": "object"
        },
        "minAllowed": {
          "additionalProperties": true,
          "description": "Lower bound of recommendations (for example `{cpu: 25m, memory: 64Mi}`).",
          "required": [],
          "type": "object"
        },
        "recommender": {
          "description": "Recommender name (`spec.recommenders`, which takes at most one). Empty: the recommender named `default`. Set it when the cluster's recommender runs under another `--recommender-name`: a VPA nobody serves gets no recommendation.",
          "type": "string"
        },
        "updateMode": {
          "description": "VPA update mode.",
          "enum": [
            "Off",
            "Initial",
            "Recreate",
            "InPlaceOrRecreate"
          ],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "required": [],
  "title": "seerr values",
  "type": "object"
}