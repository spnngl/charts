{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "description": "Affinity.",
      "required": [],
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "description": "Cryptgeon settings (upstream environment variable names), rendered into a ConfigMap read through `envFrom`. A key left out keeps the upstream default. Upstream parses every value at startup and panics on a bad one, so the schema types each key and rejects the others (`VERBOSITY` is unused upstream; `REDIS`, `LISTEN_ADDR` and `FRONTEND_PATH` belong to the chart and the image; use `extraEnv` for a setting added upstream later). Upstream defaults: `MAX_VIEWS` 100, `MAX_EXPIRATION` 360 (minutes), `ID_LENGTH` 32, `ALLOW_ADVANCED` true, `ALLOW_FILES` true, `THEME_NEW_NOTE_NOTICE` true, `THEME_HOME_LINK` true, the others empty. `SIZE_LIMIT` is the maximum request body, files included (upstream default `1 KiB`, maximum `512 MiB`); the whole body is buffered in memory, and the browser adds about 35 % of encoding overhead to a file.",
      "properties": {
        "ALLOW_ADVANCED": {
          "type": "boolean"
        },
        "ALLOW_FILES": {
          "type": "boolean"
        },
        "ID_LENGTH": {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "IMPRINT_HTML": {
          "type": "string"
        },
        "IMPRINT_URL": {
          "type": "string"
        },
        "MAX_EXPIRATION": {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "MAX_VIEWS": {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "SIZE_LIMIT": {
          "minLength": 1,
          "type": "string"
        },
        "THEME_FAVICON": {
          "type": "string"
        },
        "THEME_HOME_LINK": {
          "type": "boolean"
        },
        "THEME_IMAGE": {
          "type": "string"
        },
        "THEME_NEW_NOTE_NOTICE": {
          "type": "boolean"
        },
        "THEME_PAGE_TITLE": {
          "type": "string"
        },
        "THEME_TEXT": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "dnsConfig": {
      "additionalProperties": true,
      "description": "DNS config.",
      "properties": {
        "options": {
          "description": "DNS options (fewer search-list lookups for the Redis host name).",
          "items": {
            "additionalProperties": true,
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "extraArgs": {
      "description": "Extra arguments for the `cryptgeon` binary, which takes none today.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "extraEnv": {
      "description": "Extra environment variables (`EnvVar` list). Chart- and image-owned names are rejected. They win over `config`.",
      "items": {
        "properties": {
          "name": {
            "minLength": 1,
            "not": {
              "enum": [
                "REDIS",
                "LISTEN_ADDR",
                "FRONTEND_PATH"
              ],
              "required": []
            },
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "fullnameOverride": {
      "description": "Override the full resource name (default `\u003crelease\u003e-\u003cchart\u003e`).",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "type": "object"
    },
    "hostUsers": {
      "description": "Run the pod in a user namespace (`false`: uid 65532 maps to an unprivileged host uid). Needs node support (containerd 2.0+ or CRI-O, runc 1.2+, kernel 6.3+); pods fail to start otherwise. `true` uses host users.",
      "type": "boolean"
    },
    "httpRoute": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "HTTPRoute annotations.",
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a Gateway API HTTPRoute (path prefix `/`). Cryptgeon needs HTTPS (WebCrypto): terminate TLS on the Gateway.",
          "type": "boolean"
        },
        "hostnames": {
          "description": "Host names (empty: any host of the Gateway listener).",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra HTTPRoute labels.",
          "required": [],
          "type": "object"
        },
        "parentRefs": {
          "description": "Gateways (`parentRefs`). Required when enabled.",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "Image digest, only valid together with `image.tag`.",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "type": "string"
        },
        "pullPolicy": {
          "description": "Image pull policy.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "repository": {
          "description": "Image repository.",
          "type": "string"
        },
        "tag": {
          "description": "Image tag. Empty: the tag and digest recorded for `image.repository` in the `artifacthub.io/images` annotation of `Chart.yaml`. When set, the chart digest is not applied; add `image.digest` to pin it.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets (list of `{name: \u003csecret\u003e}`).",
      "items": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ingress": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ingress annotations (for ingress-nginx, `nginx.ingress.kubernetes.io/proxy-body-size` must exceed `config.SIZE_LIMIT`).",
          "required": [],
          "type": "object"
        },
        "className": {
          "description": "Ingress class name (empty: cluster default).",
          "type": "string"
        },
        "enabled": {
          "description": "Create an Ingress (path `/`). Cryptgeon needs HTTPS (WebCrypto): terminate TLS here or in front.",
          "type": "boolean"
        },
        "hosts": {
          "description": "Host names. Required when enabled.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra Ingress labels (for example the label an external-dns `--label-filter` selects).",
          "required": [],
          "type": "object"
        },
        "tls": {
          "description": "Ingress TLS blocks (`secretName`, `hosts`).",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "livenessProbe": {
      "additionalProperties": true,
      "description": "Liveness probe (`GET /api/status`: does not touch Redis, so a Redis outage never restarts the pod).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "nameOverride": {
      "description": "yaml-language-server: $schema=values.schema.json\nOverride the chart name used in resource names and labels.",
      "type": "string"
    },
    "networkPolicy": {
      "additionalProperties": false,
      "properties": {
        "egress": {
          "additionalProperties": false,
          "properties": {
            "dns": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "description": "DNS peers (port 53 TCP/UDP). Override for NodeLocal DNSCache or non-standard labels.",
                  "items": {
                    "required": [],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            },
            "enabled": {
              "description": "Restrict egress (DNS and `extraEgress`). Add a rule to the Redis pods in `extraEgress`: without it the app cannot reach Redis.",
              "type": "boolean"
            },
            "extraEgress": {
              "description": "Extra `NetworkPolicyEgressRule`s (the Redis pods).",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a NetworkPolicy (ingress: the HTTP port).",
          "type": "boolean"
        },
        "http": {
          "additionalProperties": false,
          "properties": {
            "from": {
              "description": "NetworkPolicyPeer list allowed to reach the HTTP port (your ingress controller or Gateway). Empty: any source.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "nodeSelector": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector.",
      "properties": {
        "kubernetes.io/os": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Pod annotations.",
      "required": [],
      "type": "object"
    },
    "podLabels": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Extra pod labels.",
      "required": [],
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "description": "Pod security context. Overrides are merged onto these defaults.",
      "properties": {
        "fsGroup": {
          "type": "integer"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "priorityClassName": {
      "description": "Priority class name.",
      "type": "string"
    },
    "readinessProbe": {
      "additionalProperties": true,
      "description": "Readiness probe (`GET /api/live`: answers 503 while Redis is unreachable, which only removes the pod from the Service).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "redis": {
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "additionalProperties": false,
          "properties": {
            "key": {
              "description": "Key of the URL in the Secret (`redis://[:password@]host[:port]/[db]`; the image has no TLS client, `rediss://` fails at startup). Read once at startup: restart the pod after changing it.",
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "description": "Name of the Secret holding the Redis URL. Empty: `\u003cfullname\u003e`. The chart never creates it: the URL can carry a password.",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "replicaCount": {
      "description": "Replicas, 0 or 1. Never more: the view counter is guarded by an in-process lock, so with two instances a note can be read more often than its view limit. `0` stops the app (maintenance). The Deployment uses the `Recreate` strategy (short downtime on every upgrade) so two instances never overlap.",
      "enum": [
        0,
        1
      ],
      "type": "integer"
    },
    "resources": {
      "additionalProperties": true,
      "description": "Resources. The memory limit bounds uploads: a request body is buffered in memory, so size it from `config.SIZE_LIMIT` times the concurrent uploads you expect (measure, then tune; VPA in `Off` mode gives recommendations). No CPU limit on purpose.",
      "properties": {
        "limits": {
          "additionalProperties": true,
          "properties": {
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "requests": {
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "revisionHistoryLimit": {
      "description": "Old ReplicaSets to keep.",
      "type": "integer"
    },
    "securityContext": {
      "additionalProperties": true,
      "description": "Container security context. Overrides are merged onto these defaults.",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "additionalProperties": true,
          "properties": {
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "privileged": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "service": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Service annotations.",
          "required": [],
          "type": "object"
        },
        "port": {
          "description": "Service port (the container listens on 8000).",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "description": "Service type.",
          "enum": [
            "ClusterIP",
            "LoadBalancer",
            "NodePort"
          ],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "ServiceAccount annotations.",
          "required": [],
          "type": "object"
        },
        "create": {
          "description": "Create the ServiceAccount.",
          "type": "boolean"
        },
        "name": {
          "description": "ServiceAccount name. Empty: `\u003cfullname\u003e` (or `default` when `create` is false).",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "tolerations": {
      "description": "Tolerations.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "verticalPodAutoscaler": {
      "additionalProperties": false,
      "properties": {
        "controlledResources": {
          "description": "Resources VPA controls.",
          "items": {
            "enum": [
              "cpu",
              "memory"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "controlledValues": {
          "description": "Whether VPA also scales limits.",
          "enum": [
            "RequestsAndLimits",
            "RequestsOnly"
          ],
          "type": "string"
        },
        "enabled": {
          "description": "Create a VerticalPodAutoscaler (needs the VPA CRDs, see the `vertical-pod-autoscaler-crds` chart).",
          "type": "boolean"
        },
        "maxAllowed": {
          "additionalProperties": true,
          "description": "Upper bound of recommendations.",
          "required": [],
          "type": "object"
        },
        "minAllowed": {
          "additionalProperties": true,
          "description": "Lower bound of recommendations (for example `{cpu: 25m, memory: 64Mi}`).",
          "required": [],
          "type": "object"
        },
        "recommender": {
          "description": "Recommender name (`spec.recommenders`, which takes at most one). Empty: the recommender named `default`. Set it when the cluster's recommender runs under another `--recommender-name`: a VPA nobody serves gets no recommendation.",
          "type": "string"
        },
        "updateMode": {
          "description": "VPA update mode.",
          "enum": [
            "Off",
            "Initial",
            "Recreate",
            "InPlaceOrRecreate"
          ],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "required": [],
  "title": "cryptgeon values",
  "type": "object"
}