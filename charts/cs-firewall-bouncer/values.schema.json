{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "metrics": {
            "properties": {
              "prometheusRule": {
                "properties": {
                  "enabled": {
                    "const": true,
                    "required": []
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "prometheusRule"
            ]
          }
        },
        "required": [
          "metrics"
        ]
      },
      "required": [],
      "then": {
        "properties": {
          "metrics": {
            "properties": {
              "podMonitor": {
                "properties": {
                  "enabled": {
                    "const": true,
                    "required": []
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "podMonitor"
            ]
          }
        },
        "required": []
      }
    }
  ],
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "description": "- operator: Exists\nAffinity.",
      "required": [],
      "type": "object"
    },
    "config": {
      "additionalProperties": true,
      "description": "Free-form bouncer configuration, merged over the image's default config (maps merge, lists replace), any key works (`nftables_hooks`, `deny_log`, `log_level`, `nftables`, `ca_cert_path`, `insecure_skip_verify`, ...). Chart-owned keys are rejected. `$VAR` / `${VAR}` in values are replaced by environment variables (see `extraEnv`).",
      "propertyNames": {
        "not": {
          "enum": [
            "mode",
            "api_url",
            "api_key",
            "cert_path",
            "key_path",
            "prometheus",
            "log_mode",
            "log_dir"
          ],
          "required": []
        },
        "required": []
      },
      "required": [],
      "type": "object"
    },
    "dnsConfig": {
      "additionalProperties": true,
      "description": "DNS config (the pod uses the host network with `dnsPolicy: ClusterFirstWithHostNet`, to resolve the LAPI Service name).",
      "properties": {
        "options": {
          "description": "DNS options.",
          "items": {
            "additionalProperties": true,
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "extraArgs": {
      "description": "Extra bouncer command-line arguments, placed after `-c \u003cconfig\u003e` (for example `-v` for verbose logs). Settings belong in `config`. `-t` and `-T` make the bouncer exit after testing / printing the config.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "extraEnv": {
      "description": "Extra environment variables (list of `EnvVar`), for example to reference in `config` as `${VAR}`. `API_URL`, `API_KEY`, `HOST_IP` and `GOMEMLIMIT` are chart-owned and rejected.",
      "items": {
        "additionalProperties": true,
        "properties": {
          "name": {
            "not": {
              "enum": [
                "API_URL",
                "API_KEY",
                "HOST_IP",
                "GOMEMLIMIT"
              ],
              "required": []
            },
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumeMounts": {
      "description": "Extra volume mounts for the bouncer container.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumes": {
      "description": "Extra volumes (for example a CA bundle for an `https://` LAPI).",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "fullnameOverride": {
      "description": "Override the full resource name (default `\u003crelease\u003e-\u003cchart\u003e`).",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "Image digest, only valid together with `image.tag`.",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "type": "string"
        },
        "pullPolicy": {
          "description": "Image pull policy.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "repository": {
          "description": "Image repository.",
          "type": "string"
        },
        "tag": {
          "description": "Image tag. Empty: `appVersion` pinned by the digest recorded in `Chart.yaml`. When set, the chart digest is not applied; add `image.digest` to pin it.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets (list of `{name: \u003csecret\u003e}`).",
      "items": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "lapi": {
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "additionalProperties": false,
          "properties": {
            "key": {
              "description": "Key of the API key in the Secret (env `API_KEY`; the bouncer has no key-file option).",
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "description": "Name of the Secret holding the bouncer API key. Empty: `\u003cfullname\u003e`. The chart never creates it.",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "url": {
          "description": "CrowdSec LAPI URL (env `API_URL`). The default is the Service of the `crowdsec` chart installed as release `crowdsec` in namespace `crowdsec`. The image has no CA bundle: for `https://` add the CA with `extraVolumes` and set `config.ca_cert_path`.",
          "pattern": "^https?://",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "livenessProbe": {
      "additionalProperties": true,
      "description": "Liveness probe, `/metrics` (the process serves HTTP). The bouncer has no other health endpoint.",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "httpGet": {
          "additionalProperties": true,
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "podMonitor": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "description": "Create a Prometheus Operator PodMonitor. The metrics then listen on the node IP instead of `127.0.0.1`: they are reachable from the node's network, firewall them if the node is public.",
              "type": "boolean"
            },
            "interval": {
              "description": "Scrape interval (empty: Prometheus default).",
              "type": "string"
            },
            "labels": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Extra labels (for example `release: kube-prometheus-stack`).",
              "required": [],
              "type": "object"
            },
            "metricRelabelings": {
              "description": "Metric relabelings.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            },
            "relabelings": {
              "description": "Relabelings.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            },
            "scrapeTimeout": {
              "description": "Scrape timeout (empty: Prometheus default).",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "port": {
          "description": "Metrics listen port. It is a port of every node (host network): the pod does not schedule on a node where it is taken.",
          "maximum": 65535,
          "minimum": 1024,
          "type": "integer"
        },
        "prometheusRule": {
          "additionalProperties": false,
          "properties": {
            "disabled": {
              "description": "Alerts to leave out (at most one: disable `prometheusRule` instead). `CSFirewallBouncerNotReady` reads kube-state-metrics (`kube_daemonset_status_desired_number_scheduled`, `kube_daemonset_status_number_ready`): without it, it never fires.",
              "items": {
                "enum": [
                  "CSFirewallBouncerNotReady",
                  "CSFirewallBouncerLapiErrors"
                ],
                "type": "string"
              },
              "maxItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "enabled": {
              "description": "Create a Prometheus Operator PrometheusRule (alerts `CSFirewallBouncerNotReady`, `CSFirewallBouncerLapiErrors`). Needs `podMonitor`: the rules select the `job` label it sets.",
              "type": "boolean"
            },
            "labels": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Extra labels (for example `release: kube-prometheus-stack`).",
              "required": [],
              "type": "object"
            },
            "lapiErrorRatio": {
              "description": "`CSFirewallBouncerLapiErrors` threshold: share of failed LAPI calls (`lapi_requests_failures_total / lapi_requests_total`, 5m rate) of a pod. While they fail, no new decision reaches the node.",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "minReadySeconds": {
      "description": "Seconds a new bouncer must be Ready before the next node is updated.",
      "minimum": 0,
      "type": "integer"
    },
    "nameOverride": {
      "description": "yaml-language-server: $schema=values.schema.json\nOverride the chart name used in resource names and labels.",
      "type": "string"
    },
    "nodeSelector": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector. Merged with the default `kubernetes.io/os: linux`: set that key to `null` to drop it.",
      "properties": {
        "kubernetes.io/os": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Pod annotations (for example `reloader.stakater.com/auto: \"true\"` to restart on Secret rotation).",
      "required": [],
      "type": "object"
    },
    "podLabels": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Extra pod labels.",
      "required": [],
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "description": "Pod security context. Overrides are merged onto these defaults. Root is required: Kubernetes has no ambient capabilities, so only root holds `NET_ADMIN`.",
      "properties": {
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "priorityClassName": {
      "description": "Priority class name. `system-node-critical` is recommended for a node-level security agent.",
      "type": "string"
    },
    "readinessProbe": {
      "additionalProperties": true,
      "description": "Readiness probe, `/metrics` (the nftables tables exist). A LAPI outage never fails it.",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "httpGet": {
          "additionalProperties": true,
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "resources": {
      "additionalProperties": true,
      "description": "Resources. A scheduling floor, not a sizing: memory grows with the number of decisions (about 1.1 MiB per 1000, measured 90 MiB peak for 50000), so the limit holds about 150000 decisions. No CPU limit on purpose. With a memory limit, `GOMEMLIMIT` is set to 90% of it (the limit must then be an integer quantity: plain, `Ki`, `Mi`, `Gi`, `Ti`, `k`, `M`, `G` or `T`). Like the other maps, `limits` and `requests` merge with these defaults: set a key to `null` to drop it.",
      "properties": {
        "limits": {
          "additionalProperties": true,
          "properties": {
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "requests": {
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "revisionHistoryLimit": {
      "description": "Old ControllerRevisions to keep.",
      "type": "integer"
    },
    "securityContext": {
      "additionalProperties": true,
      "description": "Container security context. Overrides are merged onto these defaults. `NET_ADMIN` is the only capability, needed to edit the node's nftables. On SELinux nodes that deny `netlink_netfilter_socket`, set `seLinuxOptions: {type: spc_t}`.",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "additionalProperties": true,
          "properties": {
            "add": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "type": "array"
            },
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "privileged": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "ServiceAccount annotations.",
          "required": [],
          "type": "object"
        },
        "create": {
          "description": "Create the ServiceAccount.",
          "type": "boolean"
        },
        "name": {
          "description": "ServiceAccount name. Empty: `\u003cfullname\u003e` (or `default` when `create` is false).",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "startupProbe": {
      "additionalProperties": true,
      "description": "Startup probe, `/metrics`. The bouncer serves it once its nftables tables exist. The chart sets `httpGet.host: 127.0.0.1` unless `metrics.podMonitor.enabled`.",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "httpGet": {
          "additionalProperties": true,
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "description": "Termination grace period. On SIGTERM the bouncer deletes its nftables tables, which is instant.",
      "minimum": 0,
      "type": "integer"
    },
    "tolerations": {
      "description": "Tolerations. None by default: tainted nodes (control plane) are skipped. Uncomment `operator: Exists` to run on every node.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "updateStrategy": {
      "additionalProperties": false,
      "properties": {
        "rollingUpdate": {
          "additionalProperties": false,
          "properties": {
            "maxUnavailable": {
              "description": "Nodes updated at once. A node is briefly unprotected while its bouncer restarts and pulls the decisions again.",
              "required": [],
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "required": [],
          "type": "object"
        },
        "type": {
          "description": "DaemonSet update strategy. There is no `maxSurge`: a second bouncer on a node would have its tables deleted when the first one stops.",
          "enum": [
            "RollingUpdate",
            "OnDelete"
          ],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "required": [],
  "title": "cs-firewall-bouncer values",
  "type": "object"
}