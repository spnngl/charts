    "startupProbe": {
      "additionalProperties": true,
      "description": "Startup probe (`GET /api?mode=auth\u0026output=json`, which needs no API key). SABnzbd refuses it when the kubelet's source IP is not private, or not in `config.misc.local_ranges` when set (see the README).",
      "properties": {
        "failureThreshold": {
