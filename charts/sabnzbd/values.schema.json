      },
      "type": "array"
    },
    "verticalPodAutoscaler": {
      "additionalProperties": false,
      "properties": {
        "controlledResources": {
          "description": "Resources VPA controls.",
          "items": {
            "enum": [
              "cpu",
              "memory"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "controlledValues": {
          "description": "Whether VPA also scales limits.",
          "enum": [
            "RequestsAndLimits",
            "RequestsOnly"
          ],
          "type": "string"
        },
        "enabled": {
          "description": "Create a VerticalPodAutoscaler (needs the VPA CRDs, see the `vertical-pod-autoscaler-crds` chart).",
          "type": "boolean"
        },
        "maxAllowed": {
          "additionalProperties": true,
          "description": "Upper bound of recommendations.",
          "required": [],
          "type": "object"
        },
        "minAllowed": {
          "additionalProperties": true,
          "description": "Lower bound of recommendations (for example `{cpu: 25m, memory: 64Mi}`).",
          "required": [],
          "type": "object"
