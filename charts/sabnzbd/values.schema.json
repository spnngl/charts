{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "persistence": {
            "properties": {
              "data": {
                "properties": {
                  "type": {
                    "const": "nfs",
                    "required": []
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "data"
            ]
          }
        },
        "required": [
          "persistence"
        ]
      },
      "required": [],
      "then": {
        "properties": {
          "hostUsers": {
            "const": true,
            "required": []
          },
          "persistence": {
            "properties": {
              "data": {
                "properties": {
                  "nfs": {
                    "properties": {
                      "path": {
                        "minLength": 1,
                        "required": []
                      },
                      "server": {
                        "minLength": 1,
                        "required": []
                      }
                    },
                    "required": []
                  }
                },
                "required": []
              }
            },
            "required": []
          }
        },
        "required": []
      }
    }
  ],
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "description": "Affinity.",
      "required": [],
      "type": "object"
    },
    "config": {
      "additionalProperties": {
        "type": "object"
      },
      "description": "SABnzbd settings as code, in the shape of `sabnzbd.ini`: sections (`misc`, `logging`, ...) of keys, and `servers`, `categories`, `rss`, `sorters` of one map per entry. Merged into `/config/sabnzbd.ini` at every start: a listed key reverts a UI edit at the next start, an unlisted key keeps its saved value, nothing is removed (a server left out stays: delete it in the UI). Booleans become `1`/`0`, lists comma-separated. The default puts downloads on the data volume; change it with `persistence.data.mountPath`. Secrets do not belong here (the ConfigMap is readable): use `secretConfig`. `misc.host` and `misc.port` have no effect: the image's `--server 0.0.0.0:8080` wins.",
      "properties": {
        "misc": {
          "additionalProperties": true,
          "properties": {
            "complete_dir": {
              "description": "Completed downloads, under `persistence.data.mountPath`: the path Radarr and Sonarr import from.",
              "type": "string"
            },
            "download_dir": {
              "description": "Incomplete downloads, under `persistence.data.mountPath`.",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "dnsConfig": {
      "additionalProperties": true,
      "description": "DNS config.",
      "properties": {
        "options": {
          "description": "DNS options (fewer search-list lookups for Usenet server host names).",
          "items": {
            "additionalProperties": true,
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "extraEnv": {
      "description": "Extra environment variables (`EnvVar` list) for the SABnzbd container, for example `TZ`. SABnzbd reads no settings from env: use `config` and `secretConfig`.",
      "items": {
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extraInitContainers": {
      "description": "Extra init containers, rendered as given: seed a file before start, or run a native sidecar (`restartPolicy: Always`) that calls the API. The image has no shell: use another image.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumeMounts": {
      "description": "Extra volume mounts for the SABnzbd container.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumes": {
      "description": "Extra volumes.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "fullnameOverride": {
      "description": "Override the full resource name (default `\u003crelease\u003e-\u003cchart\u003e`).",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "type": "object"
    },
    "hostUsers": {
      "description": "Run the pod in a user namespace (`false`: uid 65532 maps to an unprivileged host uid). Needs node support (containerd 2.0+ or CRI-O, runc 1.2+, kernel 6.3+) and idmapped mounts on every volume's file system (not NFS/SMB, not `hostPath` on some file systems); pods fail to start otherwise. `true` uses host users.",
      "type": "boolean"
    },
    "httpRoute": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "HTTPRoute annotations.",
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a Gateway API HTTPRoute for the web UI (path prefix `/`). Also set `config.misc.inet_exposure` and `config.misc.host_whitelist` (see the README).",
          "type": "boolean"
        },
        "hostnames": {
          "description": "Host names (empty: any host of the Gateway listener).",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra HTTPRoute labels.",
          "required": [],
          "type": "object"
        },
        "parentRefs": {
          "description": "Gateways (`parentRefs`). Required when enabled.",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "Image digest, only valid together with `image.tag`.",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "type": "string"
        },
        "pullPolicy": {
          "description": "Image pull policy.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "repository": {
          "description": "Image repository.",
          "type": "string"
        },
        "tag": {
          "description": "Image tag. Empty: the tag and digest recorded for `image.repository` in the `artifacthub.io/images` annotation of `Chart.yaml`. When set, the chart digest is not applied; add `image.digest` to pin it.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets (list of `{name: \u003csecret\u003e}`).",
      "items": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ingress": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ingress annotations.",
          "required": [],
          "type": "object"
        },
        "className": {
          "description": "Ingress class name (empty: cluster default).",
          "type": "string"
        },
        "enabled": {
          "description": "Create an Ingress for the web UI (path `/`). Also set `config.misc.inet_exposure` and `config.misc.host_whitelist` (see the README).",
          "type": "boolean"
        },
        "hosts": {
          "description": "Host names. Required when enabled.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra Ingress labels (for example the label an external-dns `--label-filter` selects).",
          "required": [],
          "type": "object"
        },
        "tls": {
          "description": "Ingress TLS blocks (`secretName`, `hosts`).",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "livenessProbe": {
      "additionalProperties": true,
      "description": "Liveness probe (`GET /api?mode=auth\u0026output=json`).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "nameOverride": {
      "description": "yaml-language-server: $schema=values.schema.json\nOverride the chart name used in resource names and labels.",
      "type": "string"
    },
    "networkPolicy": {
      "additionalProperties": false,
      "properties": {
        "egress": {
          "additionalProperties": false,
          "properties": {
            "dns": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "description": "DNS peers (port 53 TCP/UDP). Override for NodeLocal DNSCache or non-standard labels.",
                  "items": {
                    "required": [],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            },
            "enabled": {
              "description": "Restrict egress (DNS, Usenet servers and update checks on the internet, `extraEgress`).",
              "type": "boolean"
            },
            "extraEgress": {
              "description": "Extra `NetworkPolicyEgressRule`s: a Usenet server, an indexer or a notification target in a private range.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            },
            "peers": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "description": "Usenet servers, the version check and notification services (any port). Default: the internet, not the private, CGNAT and link-local ranges, so a compromised process cannot move sideways. Remove an `except` entry to reach a provider there.",
                  "items": {
                    "required": [],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a NetworkPolicy (ingress: the web port).",
          "type": "boolean"
        },
        "http": {
          "additionalProperties": false,
          "properties": {
            "from": {
              "description": "NetworkPolicyPeer list allowed to reach the web UI and API port. Empty: any source. It must admit the Ingress controller and every client of the API.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "nodeSelector": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector. With a `hostPath`, pin the pod to the node.",
      "properties": {
        "kubernetes.io/os": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "persistence": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": false,
          "properties": {
            "emptyDir": {
              "additionalProperties": false,
              "properties": {
                "sizeLimit": {
                  "description": "Size limit (`type: emptyDir`, state is lost with the pod). Empty: none.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "existingClaim": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "description": "Name of an existing PVC (`type: existingClaim`).",
                  "type": "string"
                },
                "subPath": {
                  "description": "Sub-path inside the claim.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "hostPath": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Absolute node path (`type: hostPath`), owned by uid/gid 65532. Pin the pod to the node.",
                  "type": "string"
                },
                "type": {
                  "description": "`hostPath` type. `DirectoryOrCreate` makes a root-owned directory the app cannot write.",
                  "enum": [
                    "Directory",
                    "DirectoryOrCreate"
                  ],
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "type": {
              "description": "Where `/config` (`sabnzbd.ini`, the queue state, the SQLite history in `admin/`, logs) lives. Block storage: SQLite on NFS corrupts. `volumeClaimTemplate` creates a PVC per pod and keeps it on uninstall; the other types use the matching sub-section.",
              "enum": [
                "volumeClaimTemplate",
                "existingClaim",
                "hostPath",
                "emptyDir"
              ],
              "type": "string"
            },
            "volumeClaimTemplate": {
              "additionalProperties": false,
              "properties": {
                "accessModes": {
                  "description": "Access modes.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "annotations": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "PVC annotations.",
                  "required": [],
                  "type": "object"
                },
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "PVC labels.",
                  "required": [],
                  "type": "object"
                },
                "size": {
                  "description": "Requested size. The template is immutable once installed: resize the PVC, see the README.",
                  "type": "string"
                },
                "storageClassName": {
                  "description": "StorageClass (empty: cluster default).",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "data": {
          "additionalProperties": false,
          "properties": {
            "emptyDir": {
              "additionalProperties": false,
              "properties": {
                "sizeLimit": {
                  "description": "Size limit (`type: emptyDir`, state is lost with the pod). Empty: none.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "existingClaim": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "description": "Name of an existing PVC (`type: existingClaim`).",
                  "type": "string"
                },
                "subPath": {
                  "description": "Sub-path inside the claim.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "hostPath": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Absolute node path (`type: hostPath`), writable by uid/gid 65532. Pin the pod to the node.",
                  "type": "string"
                },
                "type": {
                  "description": "`hostPath` type. `DirectoryOrCreate` makes a root-owned directory the app cannot write.",
                  "enum": [
                    "Directory",
                    "DirectoryOrCreate"
                  ],
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "mountPath": {
              "description": "Mount path. Not `/`, `/config` or `/tmp` (with or without a trailing slash).",
              "pattern": "^/[^:]+$",
              "type": "string"
            },
            "mountPropagation": {
              "description": "Mount propagation. `HostToContainer` shows a FUSE mount made on the node under the volume after the pod started (the rclone chart). `Bidirectional` is not offered: it needs a privileged container.",
              "enum": [
                "None",
                "HostToContainer"
              ],
              "type": "string"
            },
            "nfs": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Exported path on the server.",
                  "type": "string"
                },
                "server": {
                  "description": "NFS server (`type: nfs`). Needs `hostUsers: true`.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "type": {
              "description": "Where downloads land (`config.misc.download_dir` and `complete_dir`). Mount the same volume at the same path as in Sonarr and Radarr: their imports then hardlink or move instead of copying. `emptyDir` is scratch space lost with the pod; the other types use the matching sub-section. ReadWriteMany, or ReadWriteOnce with every pod on one node. `hostPath` and `nfs` ignore `fsGroup`: the share must be writable by uid/gid 65532.",
              "enum": [
                "emptyDir",
                "existingClaim",
                "hostPath",
                "nfs"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Pod annotations.",
      "required": [],
      "type": "object"
    },
    "podLabels": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Extra pod labels.",
      "required": [],
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "description": "Pod security context. Overrides are merged onto these defaults. `fsGroup` does not apply to NFS/SMB volumes or `hostPath`.",
      "properties": {
        "fsGroup": {
          "type": "integer"
        },
        "fsGroupChangePolicy": {
          "type": "string"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "priorityClassName": {
      "description": "Priority class name.",
      "type": "string"
    },
    "readinessProbe": {
      "additionalProperties": true,
      "description": "Readiness probe (`GET /api?mode=auth\u0026output=json`).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "resources": {
      "additionalProperties": true,
      "description": "Resources of the SABnzbd container and of the config init container. A scheduling floor, not a sizing: par2 repair and unpacking use CPU, the article cache uses memory (measure, then tune; VPA in `Off` mode gives recommendations). SABnzbd sizes its article cache at the first start to a quarter of the memory limit (at most 1 GiB) and keeps it: set the limit before, or set `config.misc.cache_limit`. No CPU limit on purpose.",
      "properties": {
        "limits": {
          "additionalProperties": true,
          "properties": {
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "requests": {
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "revisionHistoryLimit": {
      "description": "Old ControllerRevisions to keep.",
      "type": "integer"
    },
    "secretConfig": {
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "additionalProperties": false,
          "properties": {
            "key": {
              "description": "Key of the ini fragment in the Secret.",
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "description": "Name of a Secret holding an `sabnzbd.ini` fragment merged after `config`: `misc.api_key`, `misc.nzb_key`, `misc.username`, `misc.password`, Usenet logins under `servers`. Mounted in the config init container only. Read at startup: roll the pod after a change. Empty: none. The chart never creates it.",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "securityContext": {
      "additionalProperties": true,
      "description": "Container security context of the SABnzbd container. Overrides are merged onto these defaults.",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "additionalProperties": true,
          "properties": {
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "privileged": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "service": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Service annotations.",
          "required": [],
          "type": "object"
        },
        "port": {
          "description": "Web UI and API Service port (the container listens on 8080).",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "description": "Web UI and API Service type.",
