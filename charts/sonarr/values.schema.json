{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "auth": {
            "properties": {
              "method": {
                "const": "External",
                "required": []
              }
            },
            "required": [
              "method"
            ]
          }
        },
        "required": [
          "auth"
        ]
      },
      "required": [],
      "then": {
        "properties": {
          "networkPolicy": {
            "properties": {
              "enabled": {
                "const": true,
                "required": []
              },
              "http": {
                "properties": {
                  "from": {
                    "minItems": 1,
                    "required": []
                  }
                },
                "required": []
              }
            },
            "required": []
          }
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "externalDatabase": {
            "properties": {
              "enabled": {
                "const": true,
                "required": []
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "externalDatabase"
        ]
      },
      "required": [],
      "then": {
        "properties": {
          "externalDatabase": {
            "properties": {
              "existingSecret": {
                "properties": {
                  "name": {
                    "minLength": 1,
                    "required": []
                  }
                },
                "required": []
              },
              "host": {
                "minLength": 1,
                "required": []
              }
            },
            "required": []
          }
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "persistence": {
            "properties": {
              "data": {
                "properties": {
                  "type": {
                    "const": "nfs",
                    "required": []
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "data"
            ]
          }
        },
        "required": [
          "persistence"
        ]
      },
      "required": [],
      "then": {
        "properties": {
          "hostUsers": {
            "const": true,
            "required": []
          },
          "persistence": {
            "properties": {
              "data": {
                "properties": {
                  "nfs": {
                    "properties": {
                      "path": {
                        "minLength": 1,
                        "required": []
                      },
                      "server": {
                        "minLength": 1,
                        "required": []
                      }
                    },
                    "required": []
                  }
                },
                "required": []
              }
            },
            "required": []
          }
        },
        "required": []
      }
    }
  ],
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "description": "Affinity.",
      "required": [],
      "type": "object"
    },
    "apiKey": {
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "additionalProperties": false,
          "properties": {
            "key": {
              "description": "Key of the API key in the Secret.",
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "description": "Name of a Secret holding the API key, passed as `Sonarr__Auth__ApiKey`. Empty: no env, Sonarr generates its own key and keeps it in `config.xml`. The chart never creates the Secret.",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "auth": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "description": "Authentication method for the web UI. Empty: none is pinned and Sonarr's first-run dialog picks one and creates the user. `Basic`: browser login dialog (HTTP Basic, the credentials travel in every request: use TLS in front). `Forms`: login page; with no user yet the UI is locked (create the first one through the API, see the README). `External`: an authenticating proxy in front does the login, Sonarr trusts everything that reaches it and serves its API key to it, so it needs `networkPolicy.enabled` and a non-empty `networkPolicy.http.from`. The chart always pins `Auth__Required=Enabled`.",
          "enum": [
            "",
            "Basic",
            "Forms",
            "External"
          ],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "dnsConfig": {
      "additionalProperties": true,
      "description": "DNS config.",
      "properties": {
        "options": {
          "description": "DNS options (fewer search-list lookups for indexer host names).",
          "items": {
            "additionalProperties": true,
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "externalDatabase": {
      "additionalProperties": false,
      "properties": {
        "database": {
          "description": "Main database name (`Sonarr__Postgres__MainDb`).",
          "minLength": 1,
          "type": "string"
        },
        "enabled": {
          "description": "Use an external PostgreSQL instead of SQLite in `/config`. Sonarr creates its tables but no database: create both databases first. Enabling it on an existing install starts empty; the SQLite data is not migrated.",
          "type": "boolean"
        },
        "existingSecret": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "description": "Name of the Secret holding the database login (for example a CloudNativePG role Secret). Required when enabled. The chart never creates it.",
              "type": "string"
            },
            "passwordKey": {
              "description": "Key of the password in the Secret.",
              "minLength": 1,
              "type": "string"
            },
            "usernameKey": {
              "description": "Key of the user name in the Secret.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "host": {
          "description": "PostgreSQL host. Required when enabled.",
          "type": "string"
        },
        "logDatabase": {
          "description": "Log database name (`Sonarr__Postgres__LogDb`), different from `database`. Ignored when `Sonarr__Log__DbEnabled=false` is set in `extraEnv`.",
          "minLength": 1,
          "type": "string"
        },
        "port": {
          "description": "PostgreSQL port.",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "extraArgs": {
      "description": "Extra Sonarr options, after the chart's own `-nobrowser -data=/config`. The data directory and the options that install a service, register a URL or exit are rejected.",
      "items": {
        "minLength": 1,
        "not": {
          "pattern": "^[ /-]*(?:[dD][aA][tT][aA]=.*|\\?|[iIuU]|[rR][eE][gG][iI][sS][tT][eE][rR][uU][rR][lL]|[eE][xX][iI][tT][iI][mM][mM][eE][dD][iI][aA][tT][eE][lL][yY])[ ]*$",
          "required": []
        },
        "type": "string"
      },
      "type": "array"
    },
    "extraEnv": {
      "description": "Extra environment variables (`EnvVar` list) for the Sonarr container, for example `Sonarr__Server__AllowedHosts` or `Sonarr__App__InstanceName`. Names the chart sets are rejected (`Sonarr__Auth__{ApiKey,Enabled,Method,Required}`, `Sonarr__Server__{BindAddress,Port}`, and `Sonarr__Postgres__*` with `externalDatabase.enabled`), in any case and in the `Sonarr:Auth:Method` form.",
      "items": {
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extraInitContainers": {
      "description": "Extra init containers, rendered as given: seed a file before start, or run a native sidecar (`restartPolicy: Always`) that calls the API. The image has no shell: use another image.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumeMounts": {
      "description": "Extra volume mounts for the Sonarr container.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumes": {
      "description": "Extra volumes.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "fullnameOverride": {
      "description": "Override the full resource name (default `\u003crelease\u003e-\u003cchart\u003e`).",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "type": "object"
    },
    "hostUsers": {
      "description": "Run the pod in a user namespace (`false`: uid 65532 maps to an unprivileged host uid). Needs node support (containerd 2.0+ or CRI-O, runc 1.2+, kernel 6.3+) and idmapped mounts on every volume's file system (not NFS/SMB, not `hostPath` on some file systems); pods fail to start otherwise. `true` uses host users.",
      "type": "boolean"
    },
    "httpRoute": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "HTTPRoute annotations.",
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a Gateway API HTTPRoute for the web UI (path prefix `/`, or the `Sonarr__Server__UrlBase` set in `extraEnv`).",
          "type": "boolean"
        },
        "hostnames": {
          "description": "Host names (empty: any host of the Gateway listener).",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra HTTPRoute labels.",
          "required": [],
          "type": "object"
        },
        "parentRefs": {
          "description": "Gateways (`parentRefs`). Required when enabled.",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "Image digest, only valid together with `image.tag`.",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "type": "string"
        },
        "pullPolicy": {
          "description": "Image pull policy.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "repository": {
          "description": "Image repository.",
          "type": "string"
        },
        "tag": {
          "description": "Image tag. Empty: the tag and digest recorded for `image.repository` in the `artifacthub.io/images` annotation of `Chart.yaml`. When set, the chart digest is not applied; add `image.digest` to pin it.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets (list of `{name: \u003csecret\u003e}`).",
      "items": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ingress": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ingress annotations.",
          "required": [],
          "type": "object"
        },
        "className": {
          "description": "Ingress class name (empty: cluster default).",
          "type": "string"
        },
        "enabled": {
          "description": "Create an Ingress for the web UI (path `/`, or the `Sonarr__Server__UrlBase` set in `extraEnv`).",
          "type": "boolean"
        },
        "hosts": {
          "description": "Host names. Required when enabled.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra Ingress labels (for example the label an external-dns `--label-filter` selects).",
          "required": [],
          "type": "object"
        },
        "tls": {
          "description": "Ingress TLS blocks (`secretName`, `hosts`).",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "livenessProbe": {
      "additionalProperties": true,
      "description": "Liveness probe (TCP on the web port: a database outage must not restart the pod).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "nameOverride": {
      "description": "yaml-language-server: $schema=values.schema.json\nOverride the chart name used in resource names and labels.",
      "type": "string"
    },
    "networkPolicy": {
      "additionalProperties": false,
      "properties": {
        "egress": {
          "additionalProperties": false,
          "properties": {
            "dns": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "description": "DNS peers (port 53 TCP/UDP). Override for NodeLocal DNSCache or non-standard labels.",
                  "items": {
                    "required": [],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            },
            "enabled": {
              "description": "Restrict egress (DNS, internet indexers, `extraEgress`).",
              "type": "boolean"
            },
            "extraEgress": {
              "description": "Extra `NetworkPolicyEgressRule`s: the database, Prowlarr, SABnzbd, a media server.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            },
            "peers": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "description": "Indexers, metadata APIs and notification services (any port). Default: the internet, not the private, CGNAT and link-local ranges, so a compromised process cannot move sideways. Remove an `except` entry to reach an indexer there.",
                  "items": {
                    "required": [],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a NetworkPolicy (ingress: the web port).",
          "type": "boolean"
        },
        "http": {
          "additionalProperties": false,
          "properties": {
            "from": {
              "description": "NetworkPolicyPeer list allowed to reach the web UI and API port. Empty: any source. It must admit the Ingress controller and every app that calls Sonarr (Prowlarr, Bazarr, Seerr, Configarr).",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "nodeSelector": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector. With a `hostPath`, pin the pod to the node.",
      "properties": {
        "kubernetes.io/os": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "persistence": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": false,
          "properties": {
            "emptyDir": {
              "additionalProperties": false,
              "properties": {
                "sizeLimit": {
                  "description": "Size limit (`type: emptyDir`, state is lost with the pod). Empty: none.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "existingClaim": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "description": "Name of an existing PVC (`type: existingClaim`).",
                  "type": "string"
                },
                "subPath": {
                  "description": "Sub-path inside the claim.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "hostPath": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Absolute node path (`type: hostPath`), owned by uid/gid 65532. Pin the pod to the node.",
                  "type": "string"
                },
                "type": {
                  "description": "`hostPath` type. `DirectoryOrCreate` makes a root-owned directory the app cannot write.",
                  "enum": [
                    "Directory",
                    "DirectoryOrCreate"
                  ],
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "type": {
              "description": "Where `/config` (`config.xml`, the SQLite databases unless `externalDatabase.enabled`, logs, backups) lives. Block storage: SQLite on NFS corrupts. `volumeClaimTemplate` creates a PVC per pod and keeps it on uninstall; the other types use the matching sub-section.",
              "enum": [
                "volumeClaimTemplate",
                "existingClaim",
                "hostPath",
                "emptyDir"
              ],
              "type": "string"
            },
            "volumeClaimTemplate": {
              "additionalProperties": false,
              "properties": {
                "accessModes": {
                  "description": "Access modes.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "annotations": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "PVC annotations.",
                  "required": [],
                  "type": "object"
                },
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "PVC labels.",
                  "required": [],
                  "type": "object"
                },
                "size": {
                  "description": "Requested size. The template is immutable once installed: resize the PVC, see the README.",
                  "type": "string"
                },
                "storageClassName": {
                  "description": "StorageClass (empty: cluster default).",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "data": {
          "additionalProperties": false,
          "properties": {
            "emptyDir": {
              "additionalProperties": false,
              "properties": {
                "sizeLimit": {
                  "description": "Size limit (`type: emptyDir`, state is lost with the pod). Empty: none.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "existingClaim": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "description": "Name of an existing PVC (`type: existingClaim`).",
                  "type": "string"
                },
                "subPath": {
                  "description": "Sub-path inside the claim.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "hostPath": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Absolute node path (`type: hostPath`), writable by uid/gid 65532. Pin the pod to the node.",
                  "type": "string"
                },
                "type": {
                  "description": "`hostPath` type. `DirectoryOrCreate` makes a root-owned directory the app cannot write.",
                  "enum": [
                    "Directory",
                    "DirectoryOrCreate"
                  ],
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "mountPath": {
              "description": "Mount path. Not `/`, `/config` or `/tmp` (with or without a trailing slash).",
              "pattern": "^/[^:]+$",
              "type": "string"
            },
            "mountPropagation": {
              "description": "Mount propagation. `HostToContainer` shows a FUSE mount made on the node under the volume after the pod started (the rclone chart). `Bidirectional` is not offered: it needs a privileged container.",
              "enum": [
                "None",
                "HostToContainer"
              ],
              "type": "string"
            },
            "nfs": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Exported path on the server.",
                  "type": "string"
                },
                "server": {
                  "description": "NFS server (`type: nfs`). Needs `hostUsers: true`.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "type": {
              "description": "Where the media and download tree lives. Mount the same volume at the same path in every app that shares it: a hardlink or an atomic move needs one filesystem (see the README). `emptyDir` is scratch space lost with the pod; the other types use the matching sub-section. ReadWriteMany, or ReadWriteOnce with every pod on one node. `hostPath` and `nfs` ignore `fsGroup`: the share must be writable by uid/gid 65532.",
              "enum": [
                "emptyDir",
                "existingClaim",
                "hostPath",
                "nfs"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Pod annotations.",
      "required": [],
      "type": "object"
    },
    "podLabels": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Extra pod labels.",
      "required": [],
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "description": "Pod security context. Overrides are merged onto these defaults. `fsGroup` does not apply to NFS/SMB volumes or `hostPath`.",
      "properties": {
        "fsGroup": {
          "type": "integer"
        },
        "fsGroupChangePolicy": {
          "type": "string"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "priorityClassName": {
      "description": "Priority class name.",
      "type": "string"
    },
    "readinessProbe": {
      "additionalProperties": true,
      "description": "Readiness probe (`GET /ping`, which reads the database: the pod leaves the Service while it is down, without a restart).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "resources": {
      "additionalProperties": true,
      "description": "Resources of the Sonarr container. A scheduling floor, not a sizing: memory grows with the size of the library and of the searches (measure, then tune; VPA in `Off` mode gives recommendations). No CPU limit on purpose.",
      "properties": {
        "limits": {
          "additionalProperties": true,
          "properties": {
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "requests": {
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "revisionHistoryLimit": {
      "description": "Old ControllerRevisions to keep.",
      "type": "integer"
    },
    "securityContext": {
      "additionalProperties": true,
      "description": "Container security context of the Sonarr container. Overrides are merged onto these defaults.",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "additionalProperties": true,
          "properties": {
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "privileged": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
