{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "properties": {
          "metrics": {
            "properties": {
              "podMonitor": {
                "properties": {
                  "enabled": {
                    "const": true,
                    "required": []
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "serviceMonitor": {
                "properties": {
                  "enabled": {
                    "const": true,
                    "required": []
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "serviceMonitor",
              "podMonitor"
            ]
          }
        },
        "required": [
          "metrics"
        ]
      },
      "required": []
    },
    {
      "if": {
        "properties": {
          "metrics": {
            "properties": {
              "prometheusRule": {
                "properties": {
                  "enabled": {
                    "const": true,
                    "required": []
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "prometheusRule"
            ]
          }
        },
        "required": [
          "metrics"
        ]
      },
      "required": [],
      "then": {
        "properties": {
          "metrics": {
            "anyOf": [
              {
                "properties": {
                  "serviceMonitor": {
                    "properties": {
                      "enabled": {
                        "const": true,
                        "required": []
                      }
                    },
                    "required": [
                      "enabled"
                    ]
                  }
                },
                "required": [
                  "serviceMonitor"
                ]
              },
              {
                "properties": {
                  "podMonitor": {
                    "properties": {
                      "enabled": {
                        "const": true,
                        "required": []
                      }
                    },
                    "required": [
                      "enabled"
                    ]
                  }
                },
                "required": [
                  "podMonitor"
                ]
              }
            ],
            "required": []
          }
        },
        "required": []
      }
    }
  ],
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "description": "Affinity. Empty on purpose: a single replica has nothing to spread.",
      "required": [],
      "type": "object"
    },
    "artifacthub": {
      "additionalProperties": false,
      "properties": {
        "apiKey": {
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "additionalProperties": false,
              "properties": {
                "idKey": {
                  "description": "Key of the API key id in the Secret.",
                  "minLength": 1,
                  "type": "string"
                },
                "name": {
                  "description": "Name of an existing Secret holding an Artifact Hub API key. Empty: no key (the public API needs none). The chart never creates it: upstream reads the key from its environment only (no file option), so the chart passes it with a `secretKeyRef`.",
                  "type": "string"
                },
                "secretKey": {
                  "description": "Key of the API key secret in the Secret.",
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "collectInterval": {
          "description": "Time between two collections, in minutes and hours (`15m`, `1h`, `1h30m`). At least `5m`: the API caches its answers for 5 minutes, and the exporter exits at startup below it. A collection longer than the interval delays the next one.",
          "pattern": "^(([5-9]|[1-9][0-9]+)m|[1-9][0-9]*h([0-9]+m)?)$",
          "type": "string"
        },
        "hubStats": {
          "description": "Collect the totals of the hub (`artifacthub_hub_packages`, `artifacthub_hub_releases`): one request per collection. Empty: only when no other target is set, so the default install collects something (the exporter exits at startup without a target).",
          "required": [],
          "type": [
            "boolean",
            "null"
          ]
        },
        "orgs": {
          "description": "Organizations to collect (by name): their packages and repositories. An organization costs about 2 seconds per package per collection (see the README): prefer `repositories` or `packages` for large ones.",
          "items": {
            "pattern": "^[^,\"\\s]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "packages": {
          "description": "Packages to collect, `kind/repository/name` (`helm/bitnami/redis`). The kind is an Artifact Hub slug (`helm`, `container`, `olm`, ...): the exporter exits at startup on a kind it does not know.",
          "items": {
            "pattern": "^[^/,\"\\s]+/[^/,\"\\s]+/[^/,\"\\s]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "repositories": {
          "description": "Repositories to collect (by name), with their packages.",
          "items": {
            "pattern": "^[^,\"\\s]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "url": {
          "description": "Artifact Hub address.",
          "pattern": "^https?://\\S+$",
          "type": "string"
        },
        "users": {
          "description": "Users to collect (by alias): their packages and repositories.",
          "items": {
            "pattern": "^[^,\"\\s]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [],
      "type": "object"
    },
    "dnsConfig": {
      "additionalProperties": true,
      "description": "DNS config.",
      "properties": {
        "options": {
          "description": "DNS options (fewer search-list lookups for `artifacthub.io`).",
          "items": {
            "additionalProperties": true,
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "extraEnv": {
      "description": "Extra environment variables (`EnvVar` list), for example `HTTPS_PROXY`. Every upstream setting has a value: names the chart owns are rejected. Rendered after `WEB_PATH`.",
      "items": {
        "properties": {
          "name": {
            "minLength": 1,
            "not": {
              "enum": [
                "ARTIFACTHUB_API_KEY_ID",
                "ARTIFACTHUB_API_KEY_SECRET",
                "ARTIFACTHUB_HUB_STATS",
                "ARTIFACTHUB_ORGS",
                "ARTIFACTHUB_PACKAGES",
                "ARTIFACTHUB_REPOSITORIES",
                "ARTIFACTHUB_URL",
                "ARTIFACTHUB_USERS",
                "COLLECT_INTERVAL",
                "GOMEMLIMIT",
                "WEB_ADDR",
                "WEB_PATH"
              ],
              "required": []
            },
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumeMounts": {
      "description": "Extra volume mounts for the exporter container.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumes": {
      "description": "Extra volumes.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "fullnameOverride": {
      "description": "Override the full resource name (default `\u003crelease\u003e-\u003cchart\u003e`).",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "type": "object"
    },
    "hostUsers": {
      "description": "Run the pod in a user namespace (`false`: uid 65532 maps to an unprivileged host uid). Needs node support (containerd 2.0+ or CRI-O, runc 1.2+, kernel 6.3+); pods fail to start otherwise. `true` uses host users.",
      "type": "boolean"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "Image digest, only valid together with `image.tag`.",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "type": "string"
        },
        "pullPolicy": {
          "description": "Image pull policy.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "repository": {
          "description": "Image repository.",
          "type": "string"
        },
        "tag": {
          "description": "Image tag. Empty: `appVersion` pinned by the digest recorded in `Chart.yaml`. When set, the chart digest is not applied; add `image.digest` to pin it.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets (list of `{name: \u003csecret\u003e}`).",
      "items": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "livenessProbe": {
      "additionalProperties": true,
      "description": "Liveness probe, `/`. An Artifact Hub outage never restarts the pod.",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "httpGet": {
          "additionalProperties": true,
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "podMonitor": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "description": "Create a Prometheus Operator PodMonitor (no Service needed). Exclusive with `serviceMonitor`.",
              "type": "boolean"
            },
            "interval": {
              "description": "Scrape interval (empty: Prometheus default).",
              "type": "string"
            },
            "labels": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Extra labels.",
              "required": [],
              "type": "object"
            },
            "metricRelabelings": {
              "description": "Metric relabelings.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            },
            "relabelings": {
              "description": "Relabelings.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            },
            "scrapeTimeout": {
              "description": "Scrape timeout (empty: Prometheus default).",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "prometheusRule": {
          "additionalProperties": false,
          "properties": {
            "collectionErrorsFor": {
              "description": "`ArtifactHubCollectionErrors` window and duration: fires when every window of this length holds a failed collection of a target, for this long: repeated failures, not a single one. Covers targets never collected, which `ArtifactHubCollectionStale` cannot see. Keep it above `artifacthub.collectInterval` plus the duration of a collection, or a target failing every collection never fires it.",
              "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$",
              "type": "string"
            },
            "collectionStaleSeconds": {
              "description": "`ArtifactHubCollectionStale` threshold, in seconds since a target's last successful collection. Keep it above `artifacthub.collectInterval` plus the duration of a collection (`artifacthub_collection_duration_seconds`), or it fires between two collections.",
              "minimum": 300,
              "type": "integer"
            },
            "disabled": {
              "description": "Alerts to leave out (at most two: disable `prometheusRule` instead). `ArtifactHubExporterDown` also fires when no target exists (pod Pending) and with `replicaCount: 0`.",
              "items": {
                "enum": [
                  "ArtifactHubExporterDown",
                  "ArtifactHubCollectionStale",
                  "ArtifactHubCollectionErrors"
                ],
                "type": "string"
              },
              "maxItems": 2,
              "type": "array",
              "uniqueItems": true
            },
            "downFor": {
              "description": "`ArtifactHubExporterDown` duration.",
              "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$",
              "type": "string"
            },
            "enabled": {
              "description": "Create a Prometheus Operator PrometheusRule (alerts `ArtifactHubExporterDown`, `ArtifactHubCollectionStale`, `ArtifactHubCollectionErrors`). Needs `serviceMonitor` or `podMonitor`: the rules select the `job` label it sets.",
              "type": "boolean"
            },
            "labels": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Extra labels (for example `release: kube-prometheus-stack`).",
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "service": {
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Service annotations.",
              "required": [],
              "type": "object"
            },
            "enabled": {
              "description": "Render the metrics Service (also rendered when `serviceMonitor.enabled`).",
              "type": "boolean"
            }
          },
          "required": [],
          "type": "object"
        },
        "serviceMonitor": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "description": "Create a Prometheus Operator ServiceMonitor. Exclusive with `podMonitor`.",
              "type": "boolean"
            },
            "interval": {
              "description": "Scrape interval (empty: Prometheus default).",
              "type": "string"
            },
            "labels": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Extra labels (for example `release: kube-prometheus-stack`).",
              "required": [],
              "type": "object"
            },
            "metricRelabelings": {
              "description": "Metric relabelings.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            },
            "relabelings": {
              "description": "Relabelings.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            },
            "scrapeTimeout": {
              "description": "Scrape timeout (empty: Prometheus default).",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "minReadySeconds": {
      "description": "Seconds a new pod must be Ready before the old one is retired.",
      "minimum": 0,
      "type": "integer"
    },
    "nameOverride": {
      "description": "yaml-language-server: $schema=values.schema.json\nOverride the chart name used in resource names and labels.",
      "type": "string"
    },
    "networkPolicy": {
      "additionalProperties": false,
      "properties": {
        "egress": {
          "additionalProperties": false,
          "properties": {
            "artifacthub": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "description": "Artifact Hub peers (port 443). `artifacthub.io` is served by CloudFront, which has no stable address: any address by default. An `artifacthub.url` on another port needs `extraEgress`.",
                  "items": {
                    "required": [],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            },
            "dns": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "description": "DNS peers (port 53 TCP/UDP). Override for NodeLocal DNSCache or non-standard labels.",
                  "items": {
                    "required": [],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            },
            "enabled": {
              "description": "Restrict egress (DNS, Artifact Hub, `extraEgress`).",
              "type": "boolean"
            },
            "extraEgress": {
              "description": "Extra `NetworkPolicyEgressRule`s (for example a proxy, or a self-hosted Artifact Hub).",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a NetworkPolicy (ingress: port 8080 only).",
          "type": "boolean"
        },
        "metrics": {
          "additionalProperties": false,
          "properties": {
            "from": {
              "description": "NetworkPolicyPeer list allowed to reach port 8080. Empty: any source. Restrict it to your Prometheus.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "nodeSelector": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector. Merged with (and cannot drop) the default `kubernetes.io/os: linux`.",
      "properties": {
        "kubernetes.io/os": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Pod annotations (for example `reloader.stakater.com/auto: \"true\"` to restart on Secret rotation).",
      "required": [],
      "type": "object"
    },
    "podLabels": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Extra pod labels.",
      "required": [],
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "description": "Pod security context. Overrides are merged onto these defaults.",
      "properties": {
        "fsGroup": {
          "type": "integer"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "priorityClassName": {
      "description": "Priority class name.",
      "type": "string"
    },
    "readinessProbe": {
      "additionalProperties": true,
      "description": "Readiness probe, `/`. It answers 200 once the server listens, whatever Artifact Hub does: `/metrics` serves the last collection.",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "httpGet": {
          "additionalProperties": true,
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "replicaCount": {
      "description": "Number of exporters. Keep `1`: every replica polls Artifact Hub on its own (N replicas send N times the requests against the same rate limit, which answers 429 past roughly 100 a minute) and exports the same series (`sum()` counts them twice). An exporter outage only leaves a gap in the graphs. `0` stops the exporter.",
      "minimum": 0,
      "type": "integer"
    },
    "resources": {
      "additionalProperties": true,
      "description": "Resources. Measured on kind: about 10Mi of memory and 0.2s of CPU time for a collection of a repository of 47 packages, the hub totals and one package. Memory grows with the number of packages collected: tune for large organizations. No CPU limit on purpose. With a memory limit, `GOMEMLIMIT` follows it.",
      "properties": {
        "limits": {
          "additionalProperties": true,
          "properties": {
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "requests": {
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "revisionHistoryLimit": {
      "description": "Old ReplicaSets to keep.",
      "type": "integer"
    },
    "securityContext": {
      "additionalProperties": true,
      "description": "Container security context. Overrides are merged onto these defaults.",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "additionalProperties": true,
          "properties": {
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "privileged": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "ServiceAccount annotations.",
          "required": [],
          "type": "object"
        },
        "create": {
          "description": "Create the ServiceAccount.",
          "type": "boolean"
        },
        "name": {
          "description": "ServiceAccount name. Empty: `\u003cfullname\u003e` (or `default` when `create` is false).",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "startupProbe": {
      "additionalProperties": true,
      "description": "Startup probe, `/` (upstream has no health endpoint; `/` is a static page). Restarts a pod that does not listen within `periodSeconds` x `failureThreshold` (60s).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "httpGet": {
          "additionalProperties": true,
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "periodSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "strategy": {
      "additionalProperties": false,
      "properties": {
        "rollingUpdate": {
          "additionalProperties": true,
          "description": "Used with `RollingUpdate` only.",
          "properties": {
            "maxSurge": {
              "type": "integer"
            },
            "maxUnavailable": {
              "type": "integer"
            }
          },
          "required": [],
          "type": "object"
        },
        "type": {
          "description": "Update strategy. `Recreate` stops the old exporter first (a gap in the graphs) instead of overlapping two for `minReadySeconds`.",
          "enum": [
            "RollingUpdate",
            "Recreate"
          ],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "tolerations": {
      "description": "Tolerations.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "topologySpreadConstraints": {
      "description": "Topology spread constraints. Empty on purpose: a single replica has nothing to spread.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "verticalPodAutoscaler": {
      "additionalProperties": false,
      "properties": {
        "controlledResources": {
          "description": "Resources VPA controls.",
          "items": {
            "enum": [
              "cpu",
              "memory"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "controlledValues": {
          "description": "Whether VPA also scales limits.",
          "enum": [
            "RequestsAndLimits",
            "RequestsOnly"
          ],
          "type": "string"
        },
        "enabled": {
          "description": "Create a VerticalPodAutoscaler (needs the VPA CRDs, see the `vertical-pod-autoscaler-crds` chart).",
          "type": "boolean"
        },
        "maxAllowed": {
          "additionalProperties": true,
          "description": "Upper bound of recommendations.",
          "required": [],
          "type": "object"
        },
