{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "description": "Affinity, merged over the chart default: a preferred pod anti-affinity that spreads the replicas over nodes (set `podAntiAffinity` to replace it).",
      "required": [],
      "type": "object"
    },
    "config": {
      "additionalProperties": true,
      "description": "Sable `config.json` (see `static/config.json` upstream): `homeserverList`, `defaultHomeserver`, `allowCustomHomeservers`, `featuredCommunities`, `pushNotificationDetails`, `embeds`, `supporterAwards`, `gifs`, `calls`, `disableAccountSwitcher`, `settingsDefaults`, `hideUsernamePasswordFields`. Empty: the image's own file serves. Set: the chart mounts this map as `/app/config.json`, which replaces the image's file whole, so list every key you need: a key left out gets the app's built-in default (the six built-in homeservers with custom ones allowed; no push gateway, GIF provider, embeds, supporter awards or calls), not the image's value. The browser reads the file: every value, API keys included, is public. A change rolls the pods.",
      "required": [],
      "type": "object"
    },
    "dnsConfig": {
      "additionalProperties": true,
      "description": "DNS config.",
      "properties": {
        "options": {
          "description": "DNS options.",
          "items": {
            "additionalProperties": true,
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "extraEnv": {
      "description": "Extra environment variables (`EnvVar` list): static-web-server's `SERVER_*` settings. Names the chart, its Service, probes and mount rely on (`SERVER_PORT`, `SERVER_ROOT`, `SERVER_HEALTH`), and the image's response-header file (`SERVER_CONFIG_FILE`), are rejected.",
      "items": {
        "properties": {
          "name": {
            "minLength": 1,
            "not": {
              "enum": [
                "SERVER_PORT",
                "SERVER_ROOT",
                "SERVER_HEALTH",
                "SERVER_CONFIG_FILE"
              ],
              "required": []
            },
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumeMounts": {
      "description": "Extra volume mounts for the Sable container (not on `/app/config.json`: use `config`).",
      "items": {
        "properties": {
          "mountPath": {
            "not": {
              "enum": [
                "/app/config.json"
              ],
              "required": []
            },
            "type": "string"
          }
        },
        "required": [
          "mountPath"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumes": {
      "description": "Extra volumes (the name `config` is the chart's).",
      "items": {
        "properties": {
          "name": {
            "minLength": 1,
            "not": {
              "enum": [
                "config"
              ],
              "required": []
            },
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "fullnameOverride": {
      "description": "Override the full resource name (default `\u003crelease\u003e-\u003cchart\u003e`).",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "type": "object"
    },
    "hostUsers": {
      "description": "Run the pod in a user namespace (`false`: uid 65532 maps to an unprivileged host uid). Needs node support (containerd 2.0+ or CRI-O, runc 1.2+, kernel 6.3+); pods fail to start otherwise. `true` uses host users.",
      "type": "boolean"
    },
    "httpRoute": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "HTTPRoute annotations.",
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a Gateway API HTTPRoute (path prefix `/`). Sable needs HTTPS (service worker, WebCrypto): terminate TLS on the Gateway.",
          "type": "boolean"
        },
        "hostnames": {
          "description": "Host names (empty: any host of the Gateway listener).",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra HTTPRoute labels.",
          "required": [],
          "type": "object"
        },
        "parentRefs": {
          "description": "Gateways (`parentRefs`). Required when enabled.",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "Image digest, only valid together with `image.tag`.",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "type": "string"
        },
        "pullPolicy": {
          "description": "Image pull policy.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "repository": {
          "description": "Image repository.",
          "type": "string"
        },
        "tag": {
          "description": "Image tag. Empty: the tag and digest recorded for `image.repository` in the `artifacthub.io/images` annotation of `Chart.yaml`. When set, the chart digest is not applied; add `image.digest` to pin it.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets (list of `{name: \u003csecret\u003e}`).",
      "items": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ingress": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ingress annotations.",
          "required": [],
          "type": "object"
        },
        "className": {
          "description": "Ingress class name (empty: cluster default).",
          "type": "string"
        },
        "enabled": {
          "description": "Create an Ingress (path `/`). Sable needs HTTPS (service worker, WebCrypto): terminate TLS here or in front.",
          "type": "boolean"
        },
        "hosts": {
          "description": "Host names. Required when enabled.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra Ingress labels (for example the label an external-dns `--label-filter` selects).",
          "required": [],
          "type": "object"
        },
        "tls": {
          "description": "Ingress TLS blocks (`secretName`, `hosts`).",
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "livenessProbe": {
      "additionalProperties": true,
      "description": "Liveness probe (`GET /health`).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "minReadySeconds": {
      "description": "Seconds a new pod must be ready before it counts as available (rolling updates never drop below `replicaCount`).",
      "minimum": 0,
      "type": "integer"
    },
    "nameOverride": {
      "description": "yaml-language-server: $schema=values.schema.json\nOverride the chart name used in resource names and labels.",
      "type": "string"
    },
    "networkPolicy": {
      "additionalProperties": false,
      "properties": {
        "egress": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "description": "Restrict egress to `extraEgress` (none by default: the server makes no outbound call, so no DNS rule either).",
              "type": "boolean"
            },
            "extraEgress": {
              "description": "Extra `NetworkPolicyEgressRule`s.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "enabled": {
          "description": "Create a NetworkPolicy (ingress: the HTTP port).",
          "type": "boolean"
        },
        "http": {
          "additionalProperties": false,
          "properties": {
            "from": {
              "description": "NetworkPolicyPeer list allowed to reach the HTTP port (your ingress controller or Gateway). Empty: any source.",
              "items": {
                "required": [],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "nodeSelector": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector.",
      "properties": {
        "kubernetes.io/os": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Pod annotations.",
      "required": [],
      "type": "object"
    },
    "podDisruptionBudget": {
      "additionalProperties": false,
      "description": "PodDisruptionBudget (`unhealthyPodEvictionPolicy: AlwaysAllow`). `maxUnavailable` is a number or a percentage.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "required": [],
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "required": [],
      "type": "object"
    },
    "podLabels": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Extra pod labels.",
      "required": [],
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "description": "Pod security context. Overrides are merged onto these defaults.",
      "properties": {
        "fsGroup": {
          "type": "integer"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "priorityClassName": {
      "description": "Priority class name.",
      "type": "string"
    },
    "readinessProbe": {
      "additionalProperties": true,
      "description": "Readiness probe (`GET /health`).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "replicaCount": {
      "description": "Replicas. Sable is stateless: three keep serving through a node loss during a rolling update. `0` stops the app.",
      "minimum": 0,
      "type": "integer"
    },
    "resources": {
      "additionalProperties": true,
      "description": "Resources. A scheduling floor, not a sizing: the server serves files from disk (VPA in `Off` mode gives recommendations). No CPU limit on purpose.",
      "properties": {
        "limits": {
          "additionalProperties": true,
          "properties": {
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "requests": {
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "revisionHistoryLimit": {
      "description": "Old ReplicaSets to keep.",
      "type": "integer"
    },
    "securityContext": {
      "additionalProperties": true,
      "description": "Container security context. Overrides are merged onto these defaults.",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "additionalProperties": true,
          "properties": {
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "privileged": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seccompProfile": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "service": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Service annotations.",
          "required": [],
          "type": "object"
        },
        "port": {
          "description": "Service port (the container listens on 8080).",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "description": "Service type.",
          "enum": [
            "ClusterIP",
            "LoadBalancer",
            "NodePort"
          ],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "ServiceAccount annotations.",
          "required": [],
          "type": "object"
        },
        "create": {
          "description": "Create the ServiceAccount.",
          "type": "boolean"
        },
        "name": {
          "description": "ServiceAccount name. Empty: `\u003cfullname\u003e` (or `default` when `create` is false).",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "startupProbe": {
      "additionalProperties": true,
      "description": "Startup probe (`GET /health`).",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "description": "Seconds the pod gets to stop. It covers the 5 seconds the chart waits (`preStop`) for the endpoints to drop the pod before the server stops accepting connections, then the drain.",
      "minimum": 0,
      "type": "integer"
    },
    "tolerations": {
      "description": "Tolerations.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "topologySpreadConstraints": {
      "description": "Topology spread constraints. Empty: the chart spreads the replicas over zones (`topology.kubernetes.io/zone`, `ScheduleAnyway`). A list you set replaces it and needs its own `labelSelector`.",
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "verticalPodAutoscaler": {
      "additionalProperties": false,
      "properties": {
        "controlledResources": {
          "description": "Resources VPA controls.",
          "items": {
            "enum": [
              "cpu",
              "memory"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "controlledValues": {
          "description": "Whether VPA also scales limits.",
          "enum": [
            "RequestsAndLimits",
            "RequestsOnly"
          ],
          "type": "string"
        },
        "enabled": {
          "description": "Create a VerticalPodAutoscaler (needs the VPA CRDs, see the `vertical-pod-autoscaler-crds` chart).",
          "type": "boolean"
        },
        "maxAllowed": {
          "additionalProperties": true,
          "description": "Upper bound of recommendations.",
          "required": [],
          "type": "object"
        },
        "minAllowed": {
          "additionalProperties": true,
          "description": "Lower bound of recommendations (for example `{cpu: 25m, memory: 32Mi}`).",
          "required": [],
          "type": "object"
        },
        "recommender": {
          "description": "Recommender name (`spec.recommenders`, which takes at most one). Empty: the recommender named `default`. Set it when the cluster's recommender runs under another `--recommender-name`: a VPA nobody serves gets no recommendation.",
          "type": "string"
        },
        "updateMode": {
          "description": "VPA update mode.",
          "enum": [
            "Off",
            "Initial",
            "Recreate",
            "InPlaceOrRecreate"
          ],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "required": [],
  "title": "sable-next values",
  "type": "object"
}